[PACKAGE]
name        = "gadgets-edittools"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "EditTools: font, colour and case of the selected text"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-edittools/e851918ba826a92f485173d469a09543cfb62569"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/OLR.EditTools.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/EditTools.Tool=tools/EditTools.Tool", "test/EditToolsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/EditToolsTest.Mod"]
cmds = ["$compile EditToolsTest.Mod", "EditToolsTest.Run"]
ok   = ["EditToolsTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/OLR.EditTools.Mod = "sha256:606027f6609a56b9994914cb7379745f5c41c5971a95e6f25d6d2179df524d1f"
tools/EditTools.Tool = "sha256:c7eb23561c6a8ee518492a57577f259637353164af0ff234b179cd13b664d30a"
test/EditToolsTest.Mod = "sha256:368d99d41d7e59b1155edb16a6092e9f5c338d079ef769080a847957e848979d"
README.md = "sha256:6d30cb09202695a7760986cbe526ea2c20c23efa85ff7b844dd704624041ab45"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
