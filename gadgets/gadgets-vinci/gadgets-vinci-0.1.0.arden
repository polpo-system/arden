[PACKAGE]
name        = "gadgets-vinci"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Vinci: a language for describing graphics (Erich Oswald)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-vinci/15763c0447d2cc9c57ffe088a28462f5cba336d2"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-leonardo = "0.1.0"
gfx = "0.1.0"
gfx-ps = "0.1.0"
images = "0.1.0"
scheme = "0.1.0"
math = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/OLR.Vinci.Mod", "src/VinciGadgets.Mod", "src/VinciShapes.Mod", "src/VinciPens.Mod", "src/VinciEditors.Mod", "src/VinciDocs.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Clip.Vinci=share/Clip.Vinci", "share/CoordSys.Shape=share/CoordSys.Shape", "share/Distance.Shape=share/Distance.Shape", "share/Labels.Vinci=share/Labels.Vinci", "share/NGon.Shape=share/NGon.Shape", "share/Rect2.Shape=share/Rect2.Shape", "share/Smiley.Vinci=share/Smiley.Vinci", "share/Stars.Vinci=share/Stars.Vinci", "share/Test.Vinci=share/Test.Vinci", "share/Test1.Vinci=share/Test1.Vinci", "share/Test2.Vinci=share/Test2.Vinci", "share/Vinci.Init=share/Vinci.Init", "share/Vinci.Text=share/Vinci.Text", "share/YinYang.Shape=share/YinYang.Shape", "tools/Vinci.Tool=tools/Vinci.Tool", "test/VinciTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/VinciTest.Mod"]
cmds = ["$compile VinciTest.Mod", "VinciTest.Run"]
ok   = ["VinciTest: 3 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

