[PACKAGE]
name        = "gadgets-htmlimages"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "HTMLImages: images in HTML documents"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-htmlimages/b9bc6dae168f8dbdc432110153a98cbe57d9e6c7"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-htmldocs = "0.1.0"
gadgets-rembrandt = "0.1.0"

[MODULES]
all = ["src/HTMLImages.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/HTMLImagesTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/HTMLImagesTest.Mod"]
cmds = ["$compile HTMLImagesTest.Mod", "HTMLImagesTest.Run"]
ok   = ["HTMLImagesTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/HTMLImages.Mod = "sha256:ef0eb6cff182daa04c5226c2ba155b233814dab1be8b2740ef4808024e8a8c41"
test/HTMLImagesTest.Mod = "sha256:5a544aa0fe930b32e0e4c0d9227968ec907fa5e867ca0af8e2662c48f44f395d"
README.md = "sha256:01ddf19c4b8e9bb7601644fe60ba9052444476b93ec2e27b2f60e372286a2124"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
