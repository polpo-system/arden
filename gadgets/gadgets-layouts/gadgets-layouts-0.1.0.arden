[PACKAGE]
name        = "gadgets-layouts"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Layouts: layout descriptions realized as gadgets (Joerg Derungs)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-layouts/9a49251804ac5cb08716f92a01d45644155c9859"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/OLR.Layouts.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/LayoutsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/LayoutsTest.Mod"]
cmds = ["$compile LayoutsTest.Mod", "LayoutsTest.Run"]
ok   = ["LayoutsTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/OLR.Layouts.Mod = "sha256:a93e6b1c44dab587211d34142e402323d0cf0237c706c5c7d9b8b9bb904ba7d8"
test/LayoutsTest.Mod = "sha256:9ff753a869210fc6229be10fe905b83490534135af3bcaaa9b388b89bce1c7ab"
README.md = "sha256:d0f4cb0446645ad01320c31f148e5555443d83cb86df00ce02d3ef0c4f7a68b2"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
