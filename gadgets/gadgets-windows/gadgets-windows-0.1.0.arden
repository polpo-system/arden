[PACKAGE]
name        = "gadgets-windows"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "gadget documents in X11 windows of their own: DocWindows.OpenDoc"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-windows/03883812fc7901c126409f0cf14ed06746e4b1f8"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/DocWindows.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/DocWindows.Tool=tools/DocWindows.Tool", "test/DocWindowsTest.Mod", "README.md", "LICENSE"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/DocWindowsTest.Mod"]
cmds = ["$compile DocWindowsTest.Mod", "DocWindowsTest.Run"]
ok   = ["DocWindowsTest: 5 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/DocWindows.Mod = "sha256:b290659f32863ee6ec33e2e057a8fcbe046d33b24822990d059d8a3e94c64230"
tools/DocWindows.Tool = "sha256:bd99ca8c4843a1bd7927c9100e9c89386a8aa4baceae96d8c123f0f594c1b9b8"
test/DocWindowsTest.Mod = "sha256:c825f6d80e25995a0bb7ffec151ec86533e1718885aa91e982bbdeea58755694"
README.md = "sha256:6a3526b47617738ab66bd3cc7957c9f057bf9348d4577e3bd3ec42a3bfb48708"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
