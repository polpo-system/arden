[PACKAGE]
name        = "gadgets-objexplorer"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "ObjExplorer: the objects inside a gadget as a tree (Emil Zeller)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-objexplorer/504111627a33bba507ded17fd4dbb52e80c7a8fa"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/ObjExplorer.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/ObjExplorer.Panel=share/ObjExplorer.Panel", "tools/ObjExplorer.Tool=tools/ObjExplorer.Tool", "test/ObjExplorerTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/ObjExplorerTest.Mod"]
cmds = ["$compile ObjExplorerTest.Mod", "ObjExplorerTest.Run"]
ok   = ["ObjExplorerTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/ObjExplorer.Mod = "sha256:d73693111289a748bd09c3afdce6139fde37681a392c1a22bb65eb09855c94e0"
share/ObjExplorer.Panel = "sha256:288034b1f9082eb6ef05110aa1831bb8e02743880e50c77e0522c84128a05b2a"
tools/ObjExplorer.Tool = "sha256:5eabd52397f848458abfa49ceaae515da1560b88ca384eb9a25adc516b27ffcb"
test/ObjExplorerTest.Mod = "sha256:3495112750a2589c47566b0c620897a9935e4d70e291a77500f1bce18540d653"
README.md = "sha256:8ab9285cda8d60b391cb35c2a96ad3ed27dfc296e5e44307a638b8e3bcfa47d5"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
