[PACKAGE]
name        = "gadgets"
category    = "gadgets"
version     = "0.2.1"
author      = "polpo"
license     = "GPL-3"
description = "Gadgets of ETH Oberon System 3: the component framework, panels, documents and the standard classes"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets/18d4099928f38801b280d8ac76c12c6525f5aced"
tag  = "v0.2.1"

[DEPS]
desktop = "0.1.0"
desktop-tools = "0.1.0"
math = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/Attributes.Mod", "src/Display3.Mod", "src/Printer3.Mod", "src/Effects.Mod", "src/Links.Mod", "src/Gadgets.Mod", "src/BasicFigures.Mod", "src/BasicGadgets.Mod", "src/Clocks.Mod", "src/Panels.Mod", "src/TextFields.Mod", "src/RefGadgets.Mod", "src/Views.Mod", "src/ScrollViews.Mod", "src/TextGadgets0.Mod", "src/TextGadgets.Mod", "src/ListRiders.Mod", "src/Documents.Mod", "src/OLR.Desktops.Mod", "src/PanelDocs.Mod", "src/Columbus.Mod", "src/GadgetsIn.Mod", "src/GadgetsOut.Mod", "src/Gages.Mod", "src/Icons.Mod", "src/ListDags.Mod", "src/ListGadgets.Mod", "src/ListModels.Mod", "src/OLR.Lists.Mod", "src/NamePlates.Mod", "src/Navigators.Mod", "src/NoteBooks.Mod", "src/Organizers.Mod", "src/ProgressMeters.Mod", "src/Scrollbars.Mod", "src/SetGadgets.Mod", "src/TextDocs.Mod", "src/TimeStamps.Mod", "src/DocWindows.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Backdrop.Pict=share/Backdrop.Pict", "share/Columbus.Lib=share/Columbus.Lib", "share/Default.Pict=share/Default.Pict", "share/Documents.Panel=share/Documents.Panel", "share/Gadgets.Panel=share/Gadgets.Panel", "share/Gadgets.Pict=share/Gadgets.Pict", "share/Icons.Lib=share/Icons.Lib", "share/Libraries.Panel=share/Libraries.Panel", "share/Symbols.Lib=share/Symbols.Lib", "share/TextDocs.Lib=share/TextDocs.Lib", "share/TextDocs.Panel=share/TextDocs.Panel", "tools/TextDocs.Tool=tools/TextDocs.Tool", "test/GadgetsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH", "tools/DocWindows.Tool=tools/DocWindows.Tool", "test/DocWindowsTest.Mod"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/GadgetsTest.Mod", "test/DocWindowsTest.Mod"]
cmds = ["$compile GadgetsTest.Mod", "GadgetsTest.Run", "$compile DocWindowsTest.Mod", "DocWindowsTest.Run"]
ok   = ["GadgetsTest: 23 checks, 0 failed", "DocWindowsTest: 5 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

