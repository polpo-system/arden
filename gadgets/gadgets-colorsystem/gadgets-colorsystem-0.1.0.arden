[PACKAGE]
name        = "gadgets-colorsystem"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "ColorSystem: the colours of the display palette, palette files"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-colorsystem/e7f0b72931aa6a5594ccdf0d1523b03332596310"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/ColorSystem.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/ColorSystem.Panel=share/ColorSystem.Panel", "tools/ColorSystem.Tool=tools/ColorSystem.Tool", "test/ColorSystemTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/ColorSystemTest.Mod"]
cmds = ["$compile ColorSystemTest.Mod", "ColorSystemTest.Run"]
ok   = ["ColorSystemTest: 3 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/ColorSystem.Mod = "sha256:a2618c06754848bdc4490bbc15a9e43fc1c29a7c287108d9006ff9a37039dfa8"
share/ColorSystem.Panel = "sha256:b5a3482a751b418723e645f53d51ea57b1c5acb92fb70ae133070deba3e7f66f"
tools/ColorSystem.Tool = "sha256:715f18d3ffb5f3c7c46e959ec0664f34b808b7c3f024f5e8ad0db57f5d0ebab3"
test/ColorSystemTest.Mod = "sha256:920b6930c3c27b8c4fb6d008378ce28c7520b1610e4204243b03ab8f170411ee"
README.md = "sha256:0cd3cd1856af555eb7816c1988ca4dde73d4f04d639017cf2478f1423d8ecedd"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
