[PACKAGE]
name        = "gadgets-games-solitaire"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Solitaire: Klondike (Patrick Saladin)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-solitaire/6d8baa0ea77f736df7133c6fcbd44cd29a55da94"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-games-cards = "0.1.0"
gadgets-icons2 = "0.1.0"

[MODULES]
all = ["src/Solitaire.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Solitaire.Tool=tools/Solitaire.Tool", "test/SolitaireTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SolitaireTest.Mod"]
cmds = ["$compile SolitaireTest.Mod", "SolitaireTest.Run"]
ok   = ["SolitaireTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Solitaire.Mod = "sha256:3e37ddaad910f1cc582e03ef57feadac366be166941963699bc1948be21d0402"
tools/Solitaire.Tool = "sha256:81349d61068742c2afd3e590232c18e2bb07261cf9926b269ea754665391bc49"
test/SolitaireTest.Mod = "sha256:b229ab47fd575ece4f5e76f64f275c79c47e6cc9b778c5193097c8ae612eb7eb"
README.md = "sha256:8bd398919690eb579e9fd947ea3872b1f59aaa8b4dcc798f2838aec3b4f77f72"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
