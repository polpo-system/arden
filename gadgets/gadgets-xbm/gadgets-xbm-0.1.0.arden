[PACKAGE]
name        = "gadgets-xbm"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "XBM: reads X bitmaps as Oberon pictures (Emil Zeller)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-xbm/a8a9b759adb40bf4d3aa09088724a710675ff2e2"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/XBM.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/XBM.Tool=tools/XBM.Tool", "test/XBMTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/XBMTest.Mod"]
cmds = ["$compile XBMTest.Mod", "XBMTest.Run"]
ok   = ["XBMTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/XBM.Mod = "sha256:dbd0ec0f963fa5f1d0d574928241671c82f4a8873be92b6f00437c0fcfb0ec56"
tools/XBM.Tool = "sha256:d85ecdf9373cb4fff247922e68241025b8b65c1eb5312d7aefcbd51b3351b12e"
test/XBMTest.Mod = "sha256:9e2812b742cb7273f1f48e0cb80e107c5569c49403663020a5372fe8405359e2"
README.md = "sha256:50514fe9e1674caf2700ce9f39af65a97e10aa29b314a4c40934ccab3f38d982"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
