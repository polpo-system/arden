[PACKAGE]
name        = "gadgets-editkeys"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "EditKeys: keyboard macros for texts"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-editkeys/2144f938484a7842598c271629bed23fe55959f9"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/EditKeys.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/EditKeys.Text=share/EditKeys.Text", "tools/EditKeys.Tool=tools/EditKeys.Tool", "test/EditKeysTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/EditKeysTest.Mod"]
cmds = ["$compile EditKeysTest.Mod", "EditKeysTest.Run"]
ok   = ["EditKeysTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/EditKeys.Mod = "sha256:07acfba5c40feaebf7566bfb18e523a325a3ac9e152e7476a7a269187e7dee89"
share/EditKeys.Text = "sha256:0ff298903bba350c1b817e070360579423b6ac5d8cc09f219908c412bd9b1cb7"
tools/EditKeys.Tool = "sha256:f8a3ac34bfcf476b9e87c276f70e5b04bfe9d9c8ab195d2dbde7d7a05f2db67e"
test/EditKeysTest.Mod = "sha256:f4f88e9213c9c3519db46ae941ae0fecdad20baed9f3f377a6142286621a42e5"
README.md = "sha256:0e29db826f8f4c556bf37a563c5f90f476278a3692fd925db32afce847427e12"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
