[PACKAGE]
name        = "gadgets-finder"
category    = "gadgets"
version     = "0.1.3"
author      = "polpo"
license     = "GPL-3"
description = "Finder: lists the open documents and the templates (Emil Zeller)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-finder/6fffeeeab394d536d5062c9c02ed9ce1f15b7460"
tag  = "v0.1.3"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/Finder.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Finder.Tool=tools/Finder.Tool", "test/FinderTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/FinderTest.Mod"]
cmds = ["$compile FinderTest.Mod", "FinderTest.Run"]
ok   = ["FinderTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Finder.Mod = "sha256:116f72afee34cb811ea0561336d6192b9e1950a70c44f56064a2d1accff42d8e"
tools/Finder.Tool = "sha256:8855f65bce8df9f0b921d9f35fbce314c50479e8f5071c73252aceee99d24dcd"
test/FinderTest.Mod = "sha256:ba2e9e92e30245581d153adbd723dcb443c2d38f6e22b31554df9d6f347bd5fc"
README.md = "sha256:03831747d42e800327beaba916e26d0e621937a4e3957159bf3911c4671760be"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
