[PACKAGE]
name        = "gadgets-desktop"
category    = "gadgets"
version     = "0.1.1"
author      = "polpo"
license     = "GPL-3"
description = "the desktop of Linux Oberon: Oberon.Desk and Definitions.Tool"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-desktop/89b3c49de06b0005084c4665909894a74aa71ed2"
tag  = "v0.1.1"

[DEPS]
gadgets = "0.1.0"
gadgets-finder = "0.1.0"
gadgets-directories = "0.1.0"

[MODULES]
all = [
  "src/Definitions.Mod",
]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Oberon.Desk=share/Oberon.Desk", "tools/Definitions.Tool=tools/Definitions.Tool", "test/DesktopTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/DesktopTest.Mod"]
cmds = ["$compile DesktopTest.Mod", "DesktopTest.Run"]
ok   = ["DesktopTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Definitions.Mod = "sha256:69ac068422ce87ff87c7aef780a5e95dadd5c6322a425137ac6cdb93fe1b66d6"
share/Oberon.Desk = "sha256:178c134750e635de919556a3af58ad7a2cfa686961117bb8c161bfe065bebd92"
tools/Definitions.Tool = "sha256:b9b5232a5d87d2ae420ebc44bd5539f32848b9c01e5315525389f286489980e5"
test/DesktopTest.Mod = "sha256:e54ee11d522937ced5492870857b6a156b5cf63bc0941d1d2c3ab79ff9da2d7f"
README.md = "sha256:fb4342784b39282c1aa0568a5a531a5165e72821ed80f03fb769742eb6e57d7d"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
