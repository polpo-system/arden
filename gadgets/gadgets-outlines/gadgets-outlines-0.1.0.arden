[PACKAGE]
name        = "gadgets-outlines"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Outlines: fold parts of a text away (Patrick Saladin)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-outlines/b961c5e85bbc5e155c16d50058637a876b3b6727"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/Outlines.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Outlines.Tool=tools/Outlines.Tool", "test/OutlinesTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/OutlinesTest.Mod"]
cmds = ["$compile OutlinesTest.Mod", "OutlinesTest.Run"]
ok   = ["OutlinesTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Outlines.Mod = "sha256:84d27cf86e10a42ff45315db14e5a5c2ca422721df7c43dde2efb1469e7301af"
tools/Outlines.Tool = "sha256:a932e4e728b464d809774fad73746fddd3c4743821d624df68b046d5482b95db"
test/OutlinesTest.Mod = "sha256:493fa791880ee542e6bddd1934cd5caed56115c583c855b02b0c4cb81e1d5cda"
README.md = "sha256:10f6591e36d594f1326227e88419fde71b7d7ecfbc1199ef2193b8d201e4fff3"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
