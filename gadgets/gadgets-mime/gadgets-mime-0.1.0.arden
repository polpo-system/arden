[PACKAGE]
name        = "gadgets-mime"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "MIME: mail and HTTP headers, content types"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-mime/488f500ded8cf357b1abcf7a5688567d1afbbe86"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
streams = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/OLR.MIME.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/MIMETest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/MIMETest.Mod"]
cmds = ["$compile MIMETest.Mod", "MIMETest.Run"]
ok   = ["MIMETest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/OLR.MIME.Mod = "sha256:f76aac54e30162ce7e4d5cbf632df6343451c87b35d2902352a68d362bb834b1"
test/MIMETest.Mod = "sha256:9bae250db8727e49568b975c60bcd5f08c95b0676d9a5719ae8f969b4f0186c2"
README.md = "sha256:f9860fa503a5f84fe9c53ed318f803fc59a639227570870cde01bf62768443e1"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
