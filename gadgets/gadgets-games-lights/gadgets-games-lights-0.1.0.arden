[PACKAGE]
name        = "gadgets-games-lights"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "All Lights: switch on all 25 lights of a board, each click switches a cross of five (Andre Fischer)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-lights/25a0fbb382820fdeadc639d2a85fd782c0120225"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-layla = "0.1.0"

[MODULES]
all = ["src/AfiAllLights.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/AfiAllLights.Desc=share/AfiAllLights.Desc", "tools/AfiAllLights.Tool=tools/AfiAllLights.Tool", "test/AfiAllLightsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/AfiAllLightsTest.Mod"]
cmds = ["$compile AfiAllLightsTest.Mod", "AfiAllLightsTest.Run"]
ok   = ["AfiAllLightsTest: 5 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/AfiAllLights.Mod = "sha256:8b12b57f23fe617dcec55ab998109f402aac524d1915e2cac69eeb26ddf02d35"
share/AfiAllLights.Desc = "sha256:e07ceeda2d19a5b2f663b7b3b0451cb571214ce4af4b405f6cf38227eb9f490c"
tools/AfiAllLights.Tool = "sha256:440031703080faf4f3e944bbc333b23bbbc6137de06650a70a61989b75f97cfc"
test/AfiAllLightsTest.Mod = "sha256:1a2136c60afac29b70b742bcb46dbec326b027802bed33da5ac317ecbdc46a45"
README.md = "sha256:64f7681c66c1fae8b4e78c375f3e9c6309a82858cf51621274a2097a1e5dd18c"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
