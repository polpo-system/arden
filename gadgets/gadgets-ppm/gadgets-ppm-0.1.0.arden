[PACKAGE]
name        = "gadgets-ppm"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "PPM: reads PGM, PPM and raw PBM pictures (Wolfgang Ibl)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-ppm/03e690a50a57466809d75532e3654d2558345201"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/OLR.PPM.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/PPM.Tool=tools/PPM.Tool", "test/PPMTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/PPMTest.Mod"]
cmds = ["$compile PPMTest.Mod", "PPMTest.Run"]
ok   = ["PPMTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/OLR.PPM.Mod = "sha256:5eefc753425fb7a04b5fdb948d3fe3383b9519d4337c9d1ba8efbaaf16d07722"
tools/PPM.Tool = "sha256:7ba68e125adaaef2076425b0852a0143943807f8b28301e0a7136e968e080173"
test/PPMTest.Mod = "sha256:64fa0311f9e89873ae340a94223403250cbde7263e9d66990febe03b2c6f7a64"
README.md = "sha256:8a1caa45f9cf0d7c482f77be9b889cd4df20a2751cd2a45cb47d693270f1deca"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
