[PACKAGE]
name        = "gadgets-colors"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "ColorGadgets: colour wells, disc and wedge, the colour panel"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-colors/f05c8d5359ee123ffb1700bc32d6533000403468"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
images = "0.1.0"

[MODULES]
all = ["src/ColorGadgets.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Colors.Panel=share/Colors.Panel", "tools/Colors.Tool=tools/Colors.Tool", "test/ColorGadgetsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/ColorGadgetsTest.Mod"]
cmds = ["$compile ColorGadgetsTest.Mod", "ColorGadgetsTest.Run"]
ok   = ["ColorGadgetsTest: 4 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/ColorGadgets.Mod = "sha256:d5a2c1cf8e87045ae5329ad4edb35532414aae6435a2705c825d7bee31cb55fd"
share/Colors.Panel = "sha256:4165f10ad4baf0c6ac5080c39f958fe0d268e66a67d7b893b4d335f098b65d9d"
tools/Colors.Tool = "sha256:9647fa01b8ea7e21a2a9c8df753c7f35984528609d05ae8a8cc335b84ce10631"
test/ColorGadgetsTest.Mod = "sha256:7e206e9324f6ec74b11374a6c5cf0b75648206f3c24330b9a04a8322d70ce3ea"
README.md = "sha256:d3832c0bd3293c90d941b7091edc4c50d92f0ac007dfa4a02f55d793eeaa5938"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
