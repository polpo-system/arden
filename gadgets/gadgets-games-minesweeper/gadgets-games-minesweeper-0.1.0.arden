[PACKAGE]
name        = "gadgets-games-minesweeper"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Mine Sweeper: find the mines (Patrick Saladin, Markus Daetwyler)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-minesweeper/6096729e16b25c7e0a995fedabe7e2827c5feefd"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-icons2 = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/MineSweeper.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/MineSweeperBD.Pict=share/MineSweeperBD.Pict", "tools/MineSweeper.Tool=tools/MineSweeper.Tool", "test/MineSweeperTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/MineSweeperTest.Mod"]
cmds = ["$compile MineSweeperTest.Mod", "MineSweeperTest.Run"]
ok   = ["MineSweeperTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/MineSweeper.Mod = "sha256:c40a7857357a8cc2646e8899c613088434b476b9227d6556b58dbbb0c57b6bd2"
share/MineSweeperBD.Pict = "sha256:5710b55a098c8111d9df2d5c36e8ca983f17b9827c27dc43ab12e5a6e3535e4e"
tools/MineSweeper.Tool = "sha256:fa82eacd93f116381c2c91e8a8132ed640a12d600dd9f3817a16e446d0111fd6"
test/MineSweeperTest.Mod = "sha256:faaf6e32e00d3bffd61a7b54198d293bda0e32ee627c9fefeeaaa7e34321fd2c"
README.md = "sha256:c0c4de4ce9a1ab376f29c250f53717917c4ef60090acaab05fcef49436d3cba0"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
