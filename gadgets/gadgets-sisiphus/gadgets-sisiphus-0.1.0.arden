[PACKAGE]
name        = "gadgets-sisiphus"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Sisiphus: a small animated gadget"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-sisiphus/bbe3c41f90becc88b4698eb8cbad7beec474d495"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/Sisiphus.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Sisyphus.Data=share/Sisyphus.Data", "tools/Sisiphus.Tool=tools/Sisiphus.Tool", "test/SisiphusTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SisiphusTest.Mod"]
cmds = ["$compile SisiphusTest.Mod", "SisiphusTest.Run"]
ok   = ["SisiphusTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Sisiphus.Mod = "sha256:d626d232de3ecffa6b4ab6b44cba36bf0ce4b68c1aa65ca277df76a317842e2a"
share/Sisyphus.Data = "sha256:596c31624fe144717bea0945475942adb66ed0a52d0506d7f9705782629441a6"
tools/Sisiphus.Tool = "sha256:48724fe5b435a1b9f8fb8fa9ae8fe20e57e1d1132d066bca17f14477c3d4f27c"
test/SisiphusTest.Mod = "sha256:36967eb559622e74983a81e34aa62116612b63aaf2e77cdb8f7d6b439897fa28"
README.md = "sha256:ea28aa9a1fa6a91ea9736f2e9a5764a447a36adbdd56d0f371f4b0616b5a6ae3"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
