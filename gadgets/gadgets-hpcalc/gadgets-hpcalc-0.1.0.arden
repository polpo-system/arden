[PACKAGE]
name        = "gadgets-hpcalc"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "HPCalc: a calculator in reverse Polish notation (Patrik Reali)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-hpcalc/d64016d2419c23be4badd552b7b53dd70fe266de"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/Conversions.Mod", "src/HPCalc.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/HPCalc.Panel=share/HPCalc.Panel", "tools/HPCalc.Tool=tools/HPCalc.Tool", "test/HPCalcTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/HPCalcTest.Mod"]
cmds = ["$compile HPCalcTest.Mod", "HPCalcTest.Run"]
ok   = ["HPCalcTest: 3 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Conversions.Mod = "sha256:69d963b09d9465200498e9b8c5a116031acc8465fc4e5c362ae68a79f626ad02"
src/HPCalc.Mod = "sha256:fff17e4ca37e93d9347d40bafca0205915b9049ba2e8666f1c3f682fac71b939"
share/HPCalc.Panel = "sha256:46cdc172f923880ddfd46e3148ee9013fe023bdf234ea99e74275ab892ce6cb9"
tools/HPCalc.Tool = "sha256:f401a474b865c8afd9117245375eaa736c160539de72d143c3c2d2a092bd8ea6"
test/HPCalcTest.Mod = "sha256:002f03f14decf830f81ff106465ce4d73cf9d171f2e568c38918752f215f9481"
README.md = "sha256:4daaf27c0c511659dd6f5dec31592bf332587416cab2d77f5bb7839d1b173165"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
