[PACKAGE]
name        = "gadgets-games-pacman"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "PacMan: eat the dots of the maze and keep away from the ghosts (John Drake)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-pacman/ce0a0419a0d404fdee7b0fab0cdd6c0d3993caf9"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
desktop-tools = "0.1.0"
gif = "0.2.0"
randomnumbers = "0.1.0"

[MODULES]
all = ["src/Sprites.Mod", "src/Stacks.Mod", "src/PacMan.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/PacData.Text=share/PacData.Text", "share/PacMaze.gif=share/PacMaze.gif", "share/PacPictures.Text=share/PacPictures.Text", "share/PacSprites.gif=share/PacSprites.gif", "share/RetPath.Text=share/RetPath.Text", "tools/PacMan.Tool=tools/PacMan.Tool", "test/PacManTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/PacManTest.Mod"]
cmds = ["$compile PacManTest.Mod", "PacManTest.Run"]
ok   = ["PacManTest: 4 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Sprites.Mod = "sha256:322dde76518d85f9c1d446954fbe0b13d2d73540daa4990fe754744bfbc37a1d"
