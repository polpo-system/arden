[PACKAGE]
name        = "gadgets-webnav"
category    = "gadgets"
version     = "0.2.4"
author      = "polpo"
license     = "GPL-3"
description = "WebNavigator: an HTML 4 browser with style sheets, http and https (Bruno Eberhard, ETH)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-webnav/c779d5a0c69fb108e7a45e6b23e7171802e57924"
tag  = "v0.2.4"

[DEPS]
gadgets = "0.1.0"
gadgets-finder = "0.1.3"
gadgets-htmldocs = "0.1.0"
gadgets-nettools = "0.1.0"
netsystem = "0.1.0"
http = "0.1.0"
tls = "0.1.0"
gif = "0.1.0"
jpeg = "0.1.0"

[MODULES]
all = ["src/WebUtils.Mod", "src/WebPieces.Mod", "src/WebSGMLScanner.Mod", "src/WebSGML.Mod", "src/WebHTML4Scanner.Mod", "src/WebHTML4.Mod", "src/WebCSS2Scanner.Mod", "src/WebCSS2.Mod", "src/WebCSS2P.Mod", "src/WebNetwork.Mod", "src/WebCSS2Format.Mod", "src/WebCSS2B.Mod", "src/WebNavDocs.Mod", "src/WebNavigators.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/WebHTML4.CSS=share/WebHTML4.CSS", "share/WebHTML4Loose.SGML=share/WebHTML4Loose.SGML", "share/WebNav.gif=share/WebNav.gif", "share/WebNavSmall.gif=share/WebNavSmall.gif", "share/WebNavFonts.html=share/WebNavFonts.html", "share/WebNavTables.html=share/WebNavTables.html", "share/WebNavigatorAbout.html=share/WebNavigatorAbout.html", "share/WebNotFound.html=share/WebNotFound.html", "share/WebNotSupported.html=share/WebNotSupported.html", "share/WebNavigator.Text=share/WebNavigator.Text", "share/WebNavStart.html=share/WebNavStart.html", "share/WebNavigator.Finder=share/WebNavigator.Finder", "tools/WebNavigator.Tool=tools/WebNavigator.Tool", "test/WebNavTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/WebNavTest.Mod"]
cmds = ["$compile WebNavTest.Mod", "WebNavTest.Run"]
ok   = ["WebNavTest: 21 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

