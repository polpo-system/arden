[PACKAGE]
name        = "gadgets-htmlforms"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "HTMLForms: forms in HTML documents"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-htmlforms/ebab1de279eeea28e8ac0079e3ec99393c99e251"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-htmldocs = "0.1.0"

[MODULES]
all = ["src/HTMLForms.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/HTMLFormsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/HTMLFormsTest.Mod"]
cmds = ["$compile HTMLFormsTest.Mod", "HTMLFormsTest.Run"]
ok   = ["HTMLFormsTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/HTMLForms.Mod = "sha256:2104f8735e288fd2812ced86ece6e2f439196f5003b5a1a051dc72e380d8112f"
test/HTMLFormsTest.Mod = "sha256:43d5b1bee97c8f404b47114743ec4b28484ea205662e9f55c9350e58a371a800"
README.md = "sha256:6fa2635758d0812c192e403350e9995a3942aed486ad6ac6d56a4789231cb5d3"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
