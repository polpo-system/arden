[PACKAGE]
name        = "gadgets-find"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Find: search a string in a set of files"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-find/c3e982555fe1498054ccaf05db6fbe39c0ffc33f"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/OLR.Find.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Find.Panel=share/Find.Panel", "tools/Find.Tool=tools/Find.Tool", "test/FindTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/FindTest.Mod"]
cmds = ["$compile FindTest.Mod", "FindTest.Run"]
ok   = ["FindTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/OLR.Find.Mod = "sha256:041c1340a6b92f53cce31f4b2a04aae9aab34ed0b1cd64c3ffb52a9501c40a5c"
share/Find.Panel = "sha256:d84bf47836951bdafb8a9e08f5bca1bab417981cef715de82a430b912e48ad35"
tools/Find.Tool = "sha256:76db03f15f925b1dcc69f71717cbd9da64d0fa887ae646f51118e19fb6c44d28"
test/FindTest.Mod = "sha256:a6b4ee7d3c99cca1065206e62f10a22ce0cc7bf79646d2e61d93b8fb09a31742"
README.md = "sha256:825a7874302872cfda0f431d71c452a36a133ea6c940951e5ce2629c90f96da0"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
