[PACKAGE]
name        = "gadgets-games-scramble"
category    = "gadgets"
version     = "0.1.1"
author      = "polpo"
license     = "GPL-3"
description = "Scramble: the sliding puzzle (Emil Zeller)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-scramble/087b302365dd3ee85b450b4d4878303364b45109"
tag  = "v0.1.1"

[DEPS]
gadgets = "0.1.0"
randomnumbers = "0.1.0"
desktop-tools = "0.1.0"
gadgets-pictures = "0.1.0"

[MODULES]
all = ["src/Scramble.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Scramble.Tool=tools/Scramble.Tool", "test/ScrambleTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/ScrambleTest.Mod"]
cmds = ["$compile ScrambleTest.Mod", "ScrambleTest.Run"]
ok   = ["ScrambleTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Scramble.Mod = "sha256:aaa2856178abd8e74ebd5f90aff0cdca961a2ed5131883ff84d4fbb85308bd96"
tools/Scramble.Tool = "sha256:2954ac74e7952ce22a61da8ddd923ae9d4b85762d5aa427c1cd79bfb9e01eb65"
test/ScrambleTest.Mod = "sha256:31313baeea5908d1e37ae7b15d44ad9ad2efdf624086b3bd4cd37f8932a431a7"
README.md = "sha256:f6b97c7a04ce597d5ed047278e0febd7d03ac8b85f6480df9ce24c05e974ae4b"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
