[PACKAGE]
name        = "gadgets-rembrandt"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Rembrandt: a paint program and the documents of pictures"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-rembrandt/94b280fe6d7a0f8997a11feea533c830adf4ee2e"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-directories = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/Rembrandt0.Mod", "src/Rembrandt.Mod", "src/RembrandtDocs.Mod", "src/RembrandtTools.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Rembrandt.Lib=share/Rembrandt.Lib", "share/Rembrandt.Panel=share/Rembrandt.Panel", "tools/Rembrandt.Tool=tools/Rembrandt.Tool", "test/RembrandtTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/RembrandtTest.Mod"]
cmds = ["$compile RembrandtTest.Mod", "RembrandtTest.Run"]
ok   = ["RembrandtTest: 4 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Rembrandt0.Mod = "sha256:2f0035bc6d08fb5408d7848da61b7c1be874bf0a7b13308d3f15e44d877ece76"
