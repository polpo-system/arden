[PACKAGE]
name        = "gadgets-vnc"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "the VNC viewer of ETH Oberon (Joerg Kreienbuehl)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-vnc/36466f392ff17e750d9e547375b47476bc30788a"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
images = "0.1.0"
gadgets-images = "0.1.0"
des = "0.1.0"
netsystem = "0.1.0"

[MODULES]
all = ["src/VNCTask.Mod", "src/VNCViewers.Mod", "src/VNC.Mod", "src/VNCViewerDocs.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/VNC.Tool=tools/VNC.Tool", "test/VNCTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/VNCTest.Mod"]
cmds = ["$compile VNCTest.Mod", "VNCTest.Run"]
ok   = ["VNCTest: 3 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/VNCTask.Mod = "sha256:e4a792f4672e5394be8a4c85fa78891f8e46fb2d3d50fa5e4fb814ba6fc3f752"
src/VNCViewers.Mod = "sha256:1f91cb97e879b940efb5768c013bf610eab5617415e9bac4918e6b6f4b3285c4"
src/VNC.Mod = "sha256:288d3d2b71cb0f6ec4e6cb834bc272148ed4a65c84458fad13beb17e80421087"
src/VNCViewerDocs.Mod = "sha256:80e1fdd7ccab697275430fe8df465f44503a5723c8e7327ef35223d389653827"
tools/VNC.Tool = "sha256:5db77875020abfe086080b79b94748392b4cc555f2ac5880d19148b63904d7ac"
test/VNCTest.Mod = "sha256:903f9545ce441e2590437ee2f26ed8dca83dc9c146203e4f02458291c7f72cf7"
README.md = "sha256:c82bdd03d3b8e1af5482ddfde208312d8176c1a501e7bd43cf20e4055521cd4a"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
