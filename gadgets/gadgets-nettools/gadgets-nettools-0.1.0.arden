[PACKAGE]
name        = "gadgets-nettools"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "NetTools: the network part of the web documents"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-nettools/b22e0482e1a1a7d73fcf570be7c2ae1ab8293d14"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-hyperdocs = "0.1.0"
streams = "0.1.0"
netsystem = "0.1.0"

[MODULES]
all = ["src/ARM.NetTools.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/NetToolsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/NetToolsTest.Mod"]
cmds = ["$compile NetToolsTest.Mod", "NetToolsTest.Run"]
ok   = ["NetToolsTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/ARM.NetTools.Mod = "sha256:dbd20b6217506a721b0063813c24b4d2a6b182e6cb6fa224bfe13c0ca7d12fb4"
test/NetToolsTest.Mod = "sha256:5d5f3cb359047cacd217995bee9e6244b114c8560c2cf26d95fa4b83f073562d"
README.md = "sha256:599fea21f4d86c8be0f91a7ca9751f97709fdcde56c7b86b111a95f5292b56df"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
