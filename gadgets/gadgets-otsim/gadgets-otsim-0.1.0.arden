[PACKAGE]
name        = "gadgets-otsim"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "OTSim: a simulator of TrueType instructions (x86)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-otsim/a9fb3966ecc01d2da56b170c18285ba7d4d1d0d0"
tag  = "v0.1.0"

[DEPS]

# only x86 has the modules
[DEPS.x86]
gadgets = "0.1.0"
otype = "0.1.0"

[MODULES]
x86 = ["src/Coroutines.Mod", "src/OTSim.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
x86 = ["share/OTSim.Panel=share/OTSim.Panel", "tools/OTSim.Tool=tools/OTSim.Tool"]
all = ["test/OTSimTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/OTSimTest.Mod"]
ok   = ["OTSimTest: 4 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

# only x86 has the modules
[TESTS.x86]
cmds = ["$compile OTSimTest.Mod", "OTSimTest.Run"]

[SUMS]
src/Coroutines.Mod = "sha256:380e17e768766f0fb6983a21867baa3294814416270f751b8f86f24cdd815933"
src/OTSim.Mod = "sha256:b45bd2a7a5a053a2e3edee19c89278bef163c5f5c23140f5189519d08b36c0b0"
test/OTSimTest.Mod = "sha256:1aa62931936439574ded023d4c0b41a86237261e6cd1c925c6cbe7935e3523b6"
README.md = "sha256:3d0b6a32ed58a14c8d4c2469636bf01124e40a562b62ace4d91cde3aa89cbded"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
share/OTSim.Panel = "sha256:95aa547e1c6fc0505507989e291c2bf6ea2bd99218f583470b5c169a5e11cf7b"
tools/OTSim.Tool = "sha256:3e2e987b4a70147992ae31a58914c7294972263f9eea1293feaa01baeaf489a1"
