[PACKAGE]
name        = "gadgets-icons2"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Icons2.Lib of ETH Native Oberon: icons of documents (Solitaire, Spider, Freecell, Mine Sweeper)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-icons2/651efdd3da05b7291f50a1607b35b4ed1331f2e0"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = []

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Icons2.Lib=share/Icons2.Lib", "tools/Icons2.Tool=tools/Icons2.Tool", "test/Icons2Test.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/Icons2Test.Mod"]
cmds = ["$compile Icons2Test.Mod", "Icons2Test.Run"]
ok   = ["Icons2Test: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
share/Icons2.Lib = "sha256:6d4b60c183bdc62a5451f2596b88469a2dfec2e51f2e06883c04ec7e604c8583"
tools/Icons2.Tool = "sha256:c987eb77b6f123af7aa5bd1626610a699789533665ef045e40a448028af5e724"
test/Icons2Test.Mod = "sha256:a61501a798c6a6bd5f8044a3f7a006bed8614448677c71f40d80e1c61002d4aa"
README.md = "sha256:b62e3277a774fa0a429cac1cf6995b79cab1c7abfac3e728d80e3a2bb1fa0862"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
