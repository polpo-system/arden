[PACKAGE]
name        = "gadgets-audio"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "AudioGadgets: the gadgets of a CD player panel (Emil Zeller)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-audio/480c16b2ab4fa23f62d0811687d4d9f47dc52a6a"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/AudioGadgets.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/AudioGadgets.Tool=tools/AudioGadgets.Tool", "test/AudioGadgetsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/AudioGadgetsTest.Mod"]
cmds = ["$compile AudioGadgetsTest.Mod", "AudioGadgetsTest.Run"]
ok   = ["AudioGadgetsTest: 3 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/AudioGadgets.Mod = "sha256:185c8676de994b787c6b2bdfa4faf08b7243b34bfc2824671132ba7d35b8ff93"
tools/AudioGadgets.Tool = "sha256:e6815b82a19f32556209818ce7bd96287a731db4f958ed910fbce8c8e7d854ed"
test/AudioGadgetsTest.Mod = "sha256:74fae55fb5ec0299d7257161e1b291ed81b51a5d19c86c555a6738cd3a470a26"
README.md = "sha256:a47cd7607551a05972955a46ebf39735bdf42996269f4c41a84c7bdd33b46697"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
