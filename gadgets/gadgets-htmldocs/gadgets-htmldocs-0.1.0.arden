[PACKAGE]
name        = "gadgets-htmldocs"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "HTMLDocs: HTML pages as documents (Emil Zeller)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-htmldocs/5c4bc706eb8a55b63aa0777fd52f7ecd90a789d5"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-hyperdocs = "0.1.0"
gadgets-rembrandt = "0.1.0"
streams = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/HTTPDocs0.Mod", "src/HTMLDocs.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/HTMLDocs.Tool=tools/HTMLDocs.Tool", "test/HTMLDocsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/HTMLDocsTest.Mod"]
cmds = ["$compile HTMLDocsTest.Mod", "HTMLDocsTest.Run"]
ok   = ["HTMLDocsTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/HTTPDocs0.Mod = "sha256:71414c46eff157e7434fa4f60b9651754a59aa7b32784b666c516946df0b9f8e"
src/HTMLDocs.Mod = "sha256:069b6fed6ba449f4e3804f613a27f1734bf1167946c73a8f912ef15468ade400"
tools/HTMLDocs.Tool = "sha256:aeff4f248482a4820e743c78c31c09bce43703e430c12077eb7980980ee4464d"
test/HTMLDocsTest.Mod = "sha256:1e0cc7337484dd60fdb43beea772992fb7f65e3011fd7149f9d89fad036e00a5"
README.md = "sha256:00c5e13b6dc0e640b4e5ab419a1c27234cb539fe415f07891f7a36b5ef716b4f"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
