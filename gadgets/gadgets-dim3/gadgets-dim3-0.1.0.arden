[PACKAGE]
name        = "gadgets-dim3"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Dim3: a 3D engine for scenes of polygons (David Ulrich)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-dim3/02d4fcf80136b5baf7fa31156bf5bc8d8c04ce5e"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
math = "0.1.0"
desktop-tools = "0.1.0"
gadgets-pictures = "0.1.0"

[MODULES]
all = ["src/Dim3Base.Mod", "src/Dim3Paint.Mod", "src/Dim3Engine.Mod", "src/Dim3Read.Mod", "src/Dim3Frames.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/City.poly=share/City.poly", "share/Cube.poly=share/Cube.poly", "share/Dim3.Panel=share/Dim3.Panel", "share/Dim3Guide.Text=share/Dim3Guide.Text", "share/Example.poly=share/Example.poly", "share/Gadgets.poly=share/Gadgets.poly", "share/Room.poly=share/Room.poly", "share/Sphere.poly=share/Sphere.poly", "share/Tetra.poly=share/Tetra.poly", "share/Tree.poly=share/Tree.poly", "share/X29Plane.poly=share/X29Plane.poly", "share/XMas.poly=share/XMas.poly", "tools/Dim3.Tool=tools/Dim3.Tool", "test/Dim3Test.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/Dim3Test.Mod"]
cmds = ["$compile Dim3Test.Mod", "Dim3Test.Run"]
ok   = ["Dim3Test: 3 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

