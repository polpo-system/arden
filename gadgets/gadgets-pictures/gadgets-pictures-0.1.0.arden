[PACKAGE]
name        = "gadgets-pictures"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "the sample pictures of ETH Oberon: Clown, Grapes, Bart"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-pictures/8b9b88e4bd540d74b5f2c721adbfb4e1a0def70e"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = []

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Bart.Pict=share/Bart.Pict", "share/Clown.Pict=share/Clown.Pict", "share/Grapes.Pict=share/Grapes.Pict", "tools/Pictures.Tool=tools/Pictures.Tool", "test/PicturesTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/PicturesTest.Mod"]
cmds = ["$compile PicturesTest.Mod", "PicturesTest.Run"]
ok   = ["PicturesTest: 3 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
share/Bart.Pict = "sha256:ce326ad573ee8d221d8bebbedd39e4bccb0b499af5539256032bcd4a2b946686"
share/Clown.Pict = "sha256:cbe72abbaea07cdc988fa9b9b1e6ce330363a29450dfebf70b066447ed519d60"
share/Grapes.Pict = "sha256:5078c183fcfce1481af8d4b5942fdc97f48445dcc30e4cb75503c0e6c7d9cacc"
tools/Pictures.Tool = "sha256:4b2b276597198a6f6761b5aee72f83e0d2d50b9323b18d23f86d5b6c15392a7f"
test/PicturesTest.Mod = "sha256:f0f10de40ee2e8502f444a324e482066639883a1967cefa8be64d71d98325e93"
README.md = "sha256:514c9c750c1f3b3796af84258e3fcb6437ad2686dc33518c930c36ba2df4e8ce"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
