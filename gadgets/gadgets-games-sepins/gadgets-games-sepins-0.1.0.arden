[PACKAGE]
name        = "gadgets-games-sepins"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Sepins: a maze game in the line of Boulder Dash, with a level editor and a sprite editor (Jaco Geldenhuys)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-sepins/bf337f146212da6238d4e3c7fc977ffd75f70690"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
desktop-tools = "0.1.0"
randomnumbers = "0.1.0"

[MODULES]
all = ["src/SepinsA.Mod", "src/SepinsB.Mod", "src/SepinsC.Mod", "src/SepinsD.Mod", "src/Sepins1.Mod", "src/Sepins2.Mod", "src/SepinsData.Mod", "src/Sepins.Mod", "src/SepinsEd.Mod", "src/SepinsBits.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Sepins.Data=share/Sepins.Data", "share/Sepins.Text=share/Sepins.Text", "share/Sepins001.Data=share/Sepins001.Data", "share/Sepins002.Data=share/Sepins002.Data", "share/Sepins003.Data=share/Sepins003.Data", "share/Sepins004.Data=share/Sepins004.Data", "share/Sepins005.Data=share/Sepins005.Data", "share/Sepins006.Data=share/Sepins006.Data", "share/Sepins007.Data=share/Sepins007.Data", "share/Sepins008.Data=share/Sepins008.Data", "share/Sepins009.Data=share/Sepins009.Data", "share/Sepins010.Data=share/Sepins010.Data", "share/Sepins011.Data=share/Sepins011.Data", "share/Sepins012.Data=share/Sepins012.Data", "share/Sepins013.Data=share/Sepins013.Data", "share/Sepins014.Data=share/Sepins014.Data", "tools/Sepins.Tool=tools/Sepins.Tool", "test/SepinsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SepinsTest.Mod"]
cmds = ["$compile SepinsTest.Mod", "SepinsTest.Run"]
ok   = ["SepinsTest: 6 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

