[PACKAGE]
name        = "gadgets-colorwells"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "ColorWells: a gadget that shows and drags a colour (Erich Oswald)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-colorwells/39366fd4f5ace00502c02b9bf9282a6c816b58d9"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/ColorWells.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/ColorWells.Tool=tools/ColorWells.Tool", "test/ColorWellsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/ColorWellsTest.Mod"]
cmds = ["$compile ColorWellsTest.Mod", "ColorWellsTest.Run"]
ok   = ["ColorWellsTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/ColorWells.Mod = "sha256:552b1d02bb05f4a00052ecd4ca7755be410c637501225ff883ebddfb5df0af53"
tools/ColorWells.Tool = "sha256:48424a1b59d4145edcb98fc8532ee5c8458de923f75a126da17afcc136b3c41f"
test/ColorWellsTest.Mod = "sha256:07335abf69ea088523c0e667aafda63bcdfd8949b8b3f2c71179d2574ac0afb5"
README.md = "sha256:bef30f0fc959024ba6c8c8684a2a0398ff7d4f1704383cf47e5f5967a47eec67"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
