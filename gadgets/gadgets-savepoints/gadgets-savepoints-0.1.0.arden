[PACKAGE]
name        = "gadgets-savepoints"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "SavePoints: a fader of SaveScreen, figures of points (Jaco Geldenhuys)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-savepoints/156a80687932dc17643da49d9834bf2cdc6e9c13"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
savescreen = "0.1.0"
math = "0.1.0"
randomnumbers = "0.1.0"

[MODULES]
all = ["src/SavePoints.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/SavePoints.Data=share/SavePoints.Data", "share/SavePoints.Text=share/SavePoints.Text", "test/SavePointsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SavePointsTest.Mod"]
cmds = ["$compile SavePointsTest.Mod", "SavePointsTest.Run"]
ok   = ["SavePointsTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/SavePoints.Mod = "sha256:992e779e266e5efc36fd033de3ceac64760588c63abcd6426106c9250da10da0"
share/SavePoints.Data = "sha256:2e64f3aca41d1b0b7b858dff62aed0805145b6dd4a24e48eadc5b1d1cb233d34"
share/SavePoints.Text = "sha256:9b24cc194f9d613e9f45c85fe14206b3b7c075c872f3e25eb3c9dc325a80aed0"
test/SavePointsTest.Mod = "sha256:110caa77f1982bf9c915a26980367c7f0855b58e9b1359e19fdc0b4d0269ac93"
README.md = "sha256:4415b34f35f70151040dc7b5a13af98ab298dc728a82ed9e0486b9a95d94d2e2"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
