[PACKAGE]
name        = "gadgets-games-marble"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Marble: peg solitaire on the English and the French board (Andre Fischer)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-marble/9675cf906074a6e57e3bb58874dd0353b80437d5"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-layla = "0.1.0"

[MODULES]
all = ["src/Marble.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Marble.Desc=share/Marble.Desc", "share/MarbleFrench.Desc=share/MarbleFrench.Desc", "tools/Marble.Tool=tools/Marble.Tool", "test/MarbleTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/MarbleTest.Mod"]
cmds = ["$compile MarbleTest.Mod", "MarbleTest.Run"]
ok   = ["MarbleTest: 10 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Marble.Mod = "sha256:a7dd34b09739a3e18eb583b1bb791fb225bed2d090ef38856a08bb82ba12d665"
share/Marble.Desc = "sha256:83f2a122ccbdc683a1a19100b8d04e682a5e2c251caa81262e2aaa57d3390852"
share/MarbleFrench.Desc = "sha256:2bc4637a0f633fe597429492576ae218741db84c765249e7792187e66d119a6f"
tools/Marble.Tool = "sha256:9639b27b021886a2bd679ab9dc825fdcd163a89d5d9af93b3d925fabef17cbf6"
test/MarbleTest.Mod = "sha256:e421f9716f5e118a2f69fcbc80773eb9a3b396e8e1bb1f593336b29c8a2fb1ec"
README.md = "sha256:a7d9a3c33412cdf8a3043c7f7d23692d6364688ce8b9deca132dd5e5c5832b7d"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
