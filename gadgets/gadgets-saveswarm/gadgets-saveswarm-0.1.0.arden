[PACKAGE]
name        = "gadgets-saveswarm"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "SaveSwarm: a fader of SaveScreen, the swarm (Bruno Essmann)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-saveswarm/2e9376a7747fb1ffa14caae9bca00bcfcb3d2a29"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
savescreen = "0.1.0"
randomnumbers = "0.1.0"

[MODULES]
all = ["src/SaveSwarm.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/SaveSwarmTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SaveSwarmTest.Mod"]
cmds = ["$compile SaveSwarmTest.Mod", "SaveSwarmTest.Run"]
ok   = ["SaveSwarmTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/SaveSwarm.Mod = "sha256:f3743003655cf157af0937dec630137b4b6042b3586e52ee689d4fb7e8225415"
test/SaveSwarmTest.Mod = "sha256:34619b45dd6c3a3902b9a375efe25d5c8b6d8caf87a437f01746014ea3e058a0"
README.md = "sha256:27ad87be9de375ec7df6bb6f34d177e0ed0729ae13a521af490512dbe60334d7"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
