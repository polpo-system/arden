[PACKAGE]
name        = "gadgets-games-asteroids"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Asteroids, the classic arcade game (Wolfgang Ibl)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-asteroids/ac9072b0b3a56180fe96eb13b72df851b0534c88"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-icons3 = "0.1.0"
math = "0.1.0"
randomnumbers = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/OLR.Asteroids.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Asteroids.Tool=tools/Asteroids.Tool", "test/AsteroidsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/AsteroidsTest.Mod"]
cmds = ["$compile AsteroidsTest.Mod", "AsteroidsTest.Run"]
ok   = ["AsteroidsTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/OLR.Asteroids.Mod = "sha256:a6c45df10f947de6f212a8a4f642bf511fb10756c484f69981120190a782c3c6"
tools/Asteroids.Tool = "sha256:535f132e07eb3ade0342353126a4aa41a0f6988f62cf53a085ebd744c243d2af"
test/AsteroidsTest.Mod = "sha256:4d9b0f805e1c87c7693974a7c2ae0e380b1e6414e55a0ac4ecdc6a3db42bc7b4"
README.md = "sha256:5a9ebd0aa084845b58dcf59ccdc110348cd240f099f7a7a9a345708ff04d5e88"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
