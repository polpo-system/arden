[PACKAGE]
name        = "gadgets-snapshot"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Snapshot: pictures of the screen, viewers, documents and gadgets"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-snapshot/1b766c53453390df0ed8d67dc7b636674bf47c8b"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-rembrandt = "0.1.0"

[MODULES]
all = ["src/OLR.Snapshot.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Snapshot.Tool=tools/Snapshot.Tool", "test/SnapshotTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SnapshotTest.Mod"]
cmds = ["$compile SnapshotTest.Mod", "SnapshotTest.Run"]
ok   = ["SnapshotTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/OLR.Snapshot.Mod = "sha256:b6fad9a41b76ef1f104fdb0bd02ce608036790205e8cb977cda6046c2e396676"
tools/Snapshot.Tool = "sha256:025b8d1dcff4172a3aed72b87143a178c3e0c26725869787beb1acb063f82ead"
test/SnapshotTest.Mod = "sha256:de90dc00795ed0c2a2dfe83a4fabe5ba7d108634c9c71cdd7b57a7a729a1034d"
README.md = "sha256:12ec5a2043b5da44cf48e88c157af979b9ffc1a5b9ca8f9d01e22decd47cc40f"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
