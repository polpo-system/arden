[PACKAGE]
name        = "gadgets-buttonfield"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "ButtonField: a gadget that looks like a button and shows a value in any font (Damien Guichard)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-buttonfield/b252ded6e906ddaa9a7c96b9e7b38171d7be9804"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"

[MODULES]
all = ["src/ButtonField.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/ButtonField.Tool=tools/ButtonField.Tool", "test/ButtonFieldTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/ButtonFieldTest.Mod"]
cmds = ["$compile ButtonFieldTest.Mod", "ButtonFieldTest.Run"]
ok   = ["ButtonFieldTest: 6 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/ButtonField.Mod = "sha256:da1a0a620da1445175fbf9dd9bc82cadf7842c4e218e7cb54bf6d8d5ebee05a7"
tools/ButtonField.Tool = "sha256:ca501a4b37723dd28c6a6b02fd22f7a2c5c1b82c991822cdd909ad4042af167b"
test/ButtonFieldTest.Mod = "sha256:6cec2798de8e3d10adec375b8e5a1b8be96cff8a0ec6c74dfaa2826af4983184"
README.md = "sha256:26b74eec79344735099e9466613c729818191cf0722175fb6dea9085e839468b"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
