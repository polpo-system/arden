[PACKAGE]
name        = "gadgets-layla"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "LayLa: panels of gadgets described as text and made by a command (Joerg Derungs)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-layla/4c48b16a0999751b4917280d6bd408075ca3b2fd"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-layouts = "0.1.0"

[MODULES]
all = ["src/LayLaS.Mod", "src/LayLa.Mod", "src/LayLa2S.Mod", "src/LayLa2.Mod", "src/LayLaDemo.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/LayLa.Guide.Eng.Text=share/LayLa.Guide.Eng.Text", "share/LayLa.QuickGuide.Text=share/LayLa.QuickGuide.Text", "share/LayLa.Demo.Config=share/LayLa.Demo.Config", "share/LayLa.Include.Config=share/LayLa.Include.Config", "share/LayLa2.Demo.Config=share/LayLa2.Demo.Config", "share/LayLa2.Include.Config=share/LayLa2.Include.Config", "share/LayLaTest.Lib=share/LayLaTest.Lib", "tools/LayLa.Tool=tools/LayLa.Tool", "test/LayLaTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/LayLaTest.Mod"]
cmds = ["$compile LayLaTest.Mod", "LayLaTest.Run"]
ok   = ["LayLaTest: 13 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

