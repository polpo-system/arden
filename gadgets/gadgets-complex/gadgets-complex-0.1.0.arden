[PACKAGE]
name        = "gadgets-complex"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Complex: an example of a model gadget of your own"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-complex/aac9c9c5be0b266307ecf31940421ad88b60da49"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
math = "0.1.0"

[MODULES]
all = ["src/Complex.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Complex.Tool=tools/Complex.Tool", "test/ComplexTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/ComplexTest.Mod"]
cmds = ["$compile ComplexTest.Mod", "ComplexTest.Run"]
ok   = ["ComplexTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Complex.Mod = "sha256:bf990dd80b7fce8cc14fdbd66c5da51acbf817d33a377bc702dcd44cdcbfe8e3"
tools/Complex.Tool = "sha256:5706c65aed38798929f22d913b4eac5a80739a589e182aa5dca397e85663e8c7"
test/ComplexTest.Mod = "sha256:e1d8c3ea4a52d4d827b5c20219789bdcceaee3691bebd0aa0d69d55aeae84476"
README.md = "sha256:ce79f9c545337140295fdeab2e7a53bb0d70104d62f6975164c7b13b6f9ad2e5"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
