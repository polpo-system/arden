[PACKAGE]
name        = "gadgets-leonardo"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Leonardo: a drawing editor for structured graphics (Erich Oswald)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-leonardo/7e87874eb1649cdb00cee55e07a98b77bdca983b"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gfx = "0.1.0"
gfx-ps = "0.1.0"
images = "0.1.0"
gadgets-images = "0.1.0"
math = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/Leonardo.Mod", "src/LeoPens.Mod", "src/LeoPaths.Mod", "src/LeoOutliners.Mod", "src/LeoFrames.Mod", "src/OLR.LeoTools.Mod", "src/LeoDocs.Mod", "src/LeoCaptions.Mod", "src/LeoBasic.Mod", "src/LeoSplines.Mod", "src/LeoImages.Mod", "src/OLR.LeoPanels.Mod", "src/LeoPenEditors.Mod", "src/LeoPathEditors.Mod", "src/LeoBasicEditors.Mod", "src/LeoCaptionEditors.Mod", "src/LeoImageEditors.Mod", "src/LeoSplineEditors.Mod", "src/OLR.LeoLists.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Leonardo.Fig=share/Leonardo.Fig", "share/Leonardo.Lib=share/Leonardo.Lib", "share/Leonardo.Panel=share/Leonardo.Panel", "share/Leonardo.Text=share/Leonardo.Text", "tools/Leonardo.Tool=tools/Leonardo.Tool", "test/LeonardoTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/LeonardoTest.Mod"]
cmds = ["$compile LeonardoTest.Mod", "LeonardoTest.Run"]
ok   = ["LeonardoTest: 4 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

