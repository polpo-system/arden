[PACKAGE]
name        = "gadgets-games-tetris"
category    = "gadgets"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Tetris (Wolfgang Ibl)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gadgets-games-tetris/89a2bcee61978c1055eb2fb0a63b591a91e10f04"
tag  = "v0.1.0"

[DEPS]
gadgets = "0.1.0"
gadgets-icons3 = "0.1.0"
randomnumbers = "0.1.0"

[MODULES]
all = ["src/Tetris.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/Tetris.Panel=share/Tetris.Panel", "share/Bows.Pict=share/Bows.Pict", "share/Bricks.Pict=share/Bricks.Pict", "share/Cells.Pict=share/Cells.Pict", "share/Clouds.Pict=share/Clouds.Pict", "share/Coins.Pict=share/Coins.Pict", "share/Fractal.Pict=share/Fractal.Pict", "share/Molecules.Pict=share/Molecules.Pict", "share/Spirals.Pict=share/Spirals.Pict", "share/Surface.Pict=share/Surface.Pict", "share/Textils.Pict=share/Textils.Pict", "tools/Tetris.Tool=tools/Tetris.Tool", "test/TetrisTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/TetrisTest.Mod"]
cmds = ["$compile TetrisTest.Mod", "TetrisTest.Run"]
ok   = ["TetrisTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

