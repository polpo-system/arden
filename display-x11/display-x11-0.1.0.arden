[PACKAGE]
name        = display-x11
version     = 0.1.0
author      = polpo
license     = ETH Oberon
description = "Display and Input for X11"

[REMOTE]
type = git
uri  = https://github.com/norayr/polpo
tag  = main

[DEPS]
desktop-base = 0.1.0

[PROVIDES]
display = 0.1.0

[CONFLICTS]
display-sixel = 0.1.0

[MODULES]
all = "/x src/desktop/POLPO.Display.Mod src/desktop/POLPO.Input.Mod"
