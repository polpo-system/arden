[PACKAGE]
name        = "unixnet"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "the system calls of the voc module unixNet on Linux0, for the network modules shared with voc"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
core = "0.1.0"

[MODULES]
all = ["src/lib/unixnet/unixNet.Mod"]
