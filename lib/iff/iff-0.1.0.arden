[PACKAGE]
name        = "iff"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "IFF: Amiga IFF ILBM pictures for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/ef0af6ec8086d9d427d09f0b020a5e53cbc176ad"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/IFF.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.iff", "test/PictTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.iff", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.iff 64 48"]
ok   = ["PictTest: sample.iff 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/IFF.Mod" = "sha256:f9fc32d1f38d473569fb7bb9dea7f3914369ff990ebc0e055bb3deb4a12b7872"
"test/sample.iff" = "sha256:769dda15209b6fcee5ea5d78e802bbc26f9c4fd619246a01275c671f155f8571"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:0e543fc81cc742f87a1bc1577a72805c86a6ce5cc350877bb07323f73bf03cde"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"LICENSE.ETH" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
