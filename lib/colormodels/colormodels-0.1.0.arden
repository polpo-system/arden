[PACKAGE]
name        = "colormodels"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "ColorModels: RGB, HSV and CMY conversions (ETH Oberon)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/ef0af6ec8086d9d427d09f0b020a5e53cbc176ad"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"
desktop-tools = "0.1.0"

[MODULES]
all = ["src/ColorModels.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE", "LICENSE.ETH"]

