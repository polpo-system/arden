[PACKAGE]
name        = "png-codec"
category    = "lib"
version     = "0.1.1"
author      = "polpo"
license     = "GPL-3"
description = "PNG0: PNG pictures decoded (every kind) and encoded (8-bit RGB, RGBA) on Files and zlib; the png commands"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/png-codec/3c51353b6d6302e07ce73cde5c6d8731300826fa"
tag  = "v0.1.1"

[DEPS]
console = "0.1.0"
zlib = "0.1.0"

[MODULES]
all = ["src/PNG0.Mod", "src/png.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE", "test/PNGTest.Mod", "test/pngsuite.list", "test/PngSuite-2017jul19.tgz", "test/PngSuite.LICENSE"]

[TESTS]
copy = ["test/PNGTest.Mod", "test/pngsuite.list", "test/PngSuite-2017jul19.tgz"]
cmds = ["tar.Unpack PngSuite-2017jul19.tgz .", "$compile PNGTest.Mod", "PNGTest.Run pngsuite.list"]
ok   = ["PNGTest: 338 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]



[SUMS]
src/PNG0.Mod = "sha256:887f222fc950bb73bc4ceba07e4d09ade1d9b5f3ab7d1b9aab24c4930fcfe4c1"
src/png.Mod = "sha256:01ae29fd6052716bffd0e6275f0e2f457dba06b431e088b534909fc5b2406af3"
README.md = "sha256:999521e9eb35763efb00cd325d322861257a61a5e68f4983f7ca217a7e9a3249"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
test/PNGTest.Mod = "sha256:858623e10c9aa136abafc06fa219ac7b565bc78630f84224e4090345318b6a71"
test/pngsuite.list = "sha256:835a14cf345789690750b224b0444175d74ed04966e5cb05726ba1314f8e3657"
test/PngSuite-2017jul19.tgz = "sha256:0294b244c95a8342c01b00010cf34abdcabc7c6a34fd0fe1bd963917537bfdc8"
test/PngSuite.LICENSE = "sha256:71e1f5bf865131b5d9996e76a78372146283e5089e50f900ae927a6458b62101"
