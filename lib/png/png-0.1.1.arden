[PACKAGE]
name        = "png"
category    = "lib"
version     = "0.1.1"
author      = "polpo"
license     = "GPL-3"
description = "PNG: PNG pictures for Pictures (Pictures.Open, WebNav), RGBPictures, PNG.Store"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/png-codec/3c51353b6d6302e07ce73cde5c6d8731300826fa"
tag  = "v0.1.1"

[DEPS]
desktop = "0.1.0"
png-codec = "0.1.0"

[MODULES]
all = ["desktop/RGBPictures.Mod", "desktop/PNG.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/PNGPicturesTest.Mod", "test/PngSuite-2017jul19.tgz"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/PNGPicturesTest.Mod", "test/PngSuite-2017jul19.tgz"]
cmds = ["tar.Unpack PngSuite-2017jul19.tgz .", "$compile PNGPicturesTest.Mod", "PNGPicturesTest.Run"]
ok   = ["PNGPicturesTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true



[SUMS]
desktop/RGBPictures.Mod = "sha256:ed9faac00aa9fc06bf793a2e8871b0a867cc272689baa79750b24afa2e62de2a"
desktop/PNG.Mod = "sha256:53d5b99e0831a6d18f2dbd342952b5b4bc04948b09cdd170318c522e8c5926b9"
test/PNGPicturesTest.Mod = "sha256:d0b792faa92d3a2108cea0514995422d9cf3b65bf5c34f262a85d8b2361e8fe2"
test/PngSuite-2017jul19.tgz = "sha256:0294b244c95a8342c01b00010cf34abdcabc7c6a34fd0fe1bd963917537bfdc8"
