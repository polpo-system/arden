[PACKAGE]
name        = "images-pcx"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "PCXImages: the PCX reader and writer of Images"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/images-pcx/91ba8e95b2908d25b1763d31e9f8a67b2f9917f5"
tag  = "v0.1.0"

[DEPS]
images = "0.1.0"

[MODULES]
all = ["src/PCXImages.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/PCXImagesTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/PCXImagesTest.Mod"]
cmds = ["$compile PCXImagesTest.Mod", "PCXImagesTest.Run"]
ok   = ["PCXImagesTest: 3 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/PCXImages.Mod = "sha256:a6c7c1d5a3808892668adab49b3c8fdd30350231d772f602a27a6c1e4ab2966c"
test/PCXImagesTest.Mod = "sha256:137c4d6ae2740210c88c14d0a498962173f24553735903cc30a47c2bb049fac3"
README.md = "sha256:6e0377e11712f85bae2edcc164e6f96713d3a12a6280069c7a25173d8cf8b5f2"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
