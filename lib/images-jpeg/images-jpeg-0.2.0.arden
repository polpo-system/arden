[PACKAGE]
name        = "images-jpeg"
category    = "lib"
version     = "0.2.0"
author      = "polpo"
license     = "GPL-3"
description = "JPEGImages: the JPEG reader of Images, pictures of up to 32767 by 32767"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/images-jpeg/0e1c54993942a7af77beecf4fdd761dc18f89606"
tag  = "v0.2.0"

[DEPS]
images = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/OLR.JPEGImages.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/JPEGImagesTest.Mod", "test/zq_test.jpg", "test/zq_big.jpg", "test/zq_wide.jpg", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/JPEGImagesTest.Mod", "test/zq_test.jpg", "test/zq_big.jpg", "test/zq_wide.jpg"]
cmds = ["$compile JPEGImagesTest.Mod", "JPEGImagesTest.Run"]
ok   = ["JPEGImagesTest: 8 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/OLR.JPEGImages.Mod = "sha256:63534b7184c51ce6efbedd9be93a6b0f19fe34bce4ac1c2dff7d220c73d76cdd"
test/JPEGImagesTest.Mod = "sha256:f23691db576b70fbc90fd7541444d4633083cf95f7961b5ed50444237154be40"
test/zq_test.jpg = "sha256:be1c07996218c345e4eb7ac00b3e9e02eab17a1d7b4313f374bff61082753bdf"
test/zq_big.jpg = "sha256:864e943cb890f319ea9afaa711de5a462ffb003b5dd820d3e40788e067314bfa"
test/zq_wide.jpg = "sha256:500e7eba6c9bc4040d495becd66bf94036d04e6299f716116cd030bf36aad059"
README.md = "sha256:4e11512d3933c3f8e512e9f088f3d9b1f45941edb36c1828068194147632058d"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
