[PACKAGE]
name        = "images-jpeg"
category    = "lib"
version     = "0.3.0"
author      = "polpo"
license     = "GPL-3"
description = "JPEGImages: JPEG pictures (baseline, progressive) for Images, read and written"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/jpeg-codec/84e0c1078089fdd7bed496fa423b2d22c8372c7e"
tag  = "v0.1.0"

[DEPS]
images = "0.1.0"
jpeg-codec = "0.1.0"

[MODULES]
all = ["desktop/JPEGImages.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/JPEGImagesTest.Mod", "test/jpegsuite.tgz"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/JPEGImagesTest.Mod", "test/jpegsuite.tgz"]
cmds = ["tar.Unpack jpegsuite.tgz .", "$compile JPEGImagesTest.Mod", "JPEGImagesTest.Run"]
ok   = ["JPEGImagesTest: 6 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
desktop/JPEGImages.Mod = "sha256:42cceab51f85359b2ef3dfeed2b91410f8f83db7cc7d8e4d361b997f74ab6be0"
test/JPEGImagesTest.Mod = "sha256:5dbf47d90d47636ceaf2552343d3e905c497ccc69fec393779c588cd10e0bc72"
test/jpegsuite.tgz = "sha256:0a42f0906eebc4f81655671c695e709050408dfe4a5f94fcee5f9b76e1feff89"
