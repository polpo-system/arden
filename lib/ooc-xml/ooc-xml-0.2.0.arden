[PACKAGE]
name        = "ooc-xml"
category    = "lib"
version     = "0.2.0"
author      = "Michael van Acken (ooc-libxml); the voc port; polpo"
license     = "LGPL-2+"
description = "XML of ooc-libxml 3.2.0 (Michael van Acken), by way of the voc port: parser, DTD validation, namespaces, codecs, writer, element streams (XMPP); xmlcheck; on x86 (type-bound procedures)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/ooc-xml/af8e87347baec466957029e6a36a3959c3685458"
tag  = "v0.2.0"

[DEPS]
console = "0.1.0"
ooc-strings = "0.1.0"
ooc-io = "0.1.0"
ooc-uri = "0.1.0"

[MODULES]
x86 = [
  "/2 src/XML/UnicodeCodec.Mod",
  "/2 src/XML/UnicodeCodec/ASCII.Mod",
  "/2 src/XML/UnicodeCodec/Latin1.Mod",
  "/2 src/XML/UnicodeCodec/UTF8.Mod",
  "/2 src/XML/UnicodeCodec/UTF16.Mod",
  "/2 src/XML/UnicodeCodec/ImportAll.Mod",
  "/2 src/XML/Limits.Mod",
  "/2 src/XML/InputBuffer.Mod",
  "/2 src/XML/UnicodeBuffer.Mod",
  "/2 src/XML/DTD.Mod",
  "/2 src/XML/EntityResolver.Mod",
  "/2 src/XML/Error.Mod",
  "/2 src/XML/Locator.Mod",
  "/2 src/XML/Builder.Mod",
  "/2 src/XML/Parser.Mod",
  "/2 src/XML/Builder/Namespaces.Mod",
  "/2 src/XML/Regexp.Mod",
  "/2 src/XML/Builder/Validation.Mod",
  "/2 src/XML/Writer.Mod",
  "/2 src/XML/Builder/Canonical.Mod",
  "/2 src/XML/Builder/ParserProtocol.Mod",
  "/2 src/XML/Basic/Element.Mod",
  "/2 src/XML/Basic/DataType.Mod",
  "/2 src/XML/Basic/Parser.Mod",
  "/2 src/XML/Stream.Mod",
  "/2 polpo/src/XMLCheck0.Mod",
  "/2 polpo/src/xmlcheck.Mod",
]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["polpo/tools/XMLCheck.Tool=tools/XMLCheck.Tool", "README.md", "COPYING",
  "tests/voc/TestUnicodeCodecs.Mod",
  "tests/voc/TestUnicodeMessages.Mod",
  "tests/voc/TestMemoryBuffers.Mod",
  "tests/voc/TestDTDResolver.Mod",
  "tests/voc/TestParser.Mod",
  "tests/voc/TestNamespaces.Mod",
  "tests/voc/TestValidation.Mod",
  "tests/voc/TestWriter.Mod",
  "tests/voc/TestBasic.Mod",
  "tests/voc/TestProtocol.Mod",
  "tests/voc/TestEntityPolicy.Mod",
  "tests/voc/TestLimits.Mod",
  "tests/voc/TestStream.Mod",
  "polpo/test/TestCodecVectors.Mod",
  "polpo/test/XMLTests.Mod",
  "polpo/test/XMLConformance.Mod",
  "polpo/test/XMLStress.Mod",
  "polpo/test/wf.list",
  "polpo/test/canonical.list",
  "polpo/test/validation.list",
  "polpo/test/misc.list",
  "polpo/test/protocol.list",
  "polpo/test/namespaces-protocol.list",
  "polpo/test/local.tar.gz",
  "tests/3rd-party-archives/xmltest.tar.gz",
  "tests/3rd-party-archives/ibm.tar.gz",
  "tests/3rd-party-archives/sun.tar.gz",
  "tests/3rd-party-archives/oasis.tar.gz"
]

[TESTS]
copy = [
  "tests/voc/TestUnicodeCodecs.Mod",
  "tests/voc/TestUnicodeMessages.Mod",
  "tests/voc/TestMemoryBuffers.Mod",
  "tests/voc/TestDTDResolver.Mod",
  "tests/voc/TestParser.Mod",
  "tests/voc/TestNamespaces.Mod",
  "tests/voc/TestValidation.Mod",
  "tests/voc/TestWriter.Mod",
  "tests/voc/TestBasic.Mod",
  "tests/voc/TestProtocol.Mod",
  "tests/voc/TestEntityPolicy.Mod",
  "tests/voc/TestLimits.Mod",
  "tests/voc/TestStream.Mod",
  "polpo/test/TestCodecVectors.Mod",
  "polpo/test/XMLTests.Mod",
  "polpo/test/XMLConformance.Mod",
  "polpo/test/XMLStress.Mod",
  "polpo/test/wf.list",
  "polpo/test/canonical.list",
  "polpo/test/validation.list",
  "polpo/test/misc.list",
  "polpo/test/protocol.list",
  "polpo/test/namespaces-protocol.list",
  "polpo/test/local.tar.gz",
  "tests/3rd-party-archives/xmltest.tar.gz",
  "tests/3rd-party-archives/ibm.tar.gz",
  "tests/3rd-party-archives/sun.tar.gz",
  "tests/3rd-party-archives/oasis.tar.gz",
]
ok   = ["XMLTests: 14 test modules passed",
  "XMLConformance wf.list: 384 checks, 0 failed",
  "XMLConformance canonical.list: 339 checks, 0 failed",
  "XMLConformance validation.list: 1808 checks, 0 failed",
  "XMLConformance misc.list: 126 checks, 0 failed",
  "XMLConformance ../protocol.list: 6 checks, 0 failed",
  "XMLConformance ../namespaces-protocol.list: 24 checks, 0 failed",
  "XMLStress.Fuzz: 2845 checks, 0 failed",
  "XMLStress.Limits: 53 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]

[TESTS.x86]
cmds = [
  "$compile /2 TestUnicodeCodecs.Mod",
  "$compile /2 TestCodecVectors.Mod",
  "$compile /2 TestUnicodeMessages.Mod",
  "$compile /2 TestMemoryBuffers.Mod",
  "$compile /2 TestDTDResolver.Mod",
  "$compile /2 TestParser.Mod",
  "$compile /2 TestNamespaces.Mod",
  "$compile /2 TestValidation.Mod",
  "$compile /2 TestWriter.Mod",
  "$compile /2 TestBasic.Mod",
  "$compile /2 TestProtocol.Mod",
  "$compile /2 TestEntityPolicy.Mod",
  "$compile /2 TestLimits.Mod",
  "$compile /2 TestStream.Mod",
  "$compile /2 XMLTests.Mod",
  "$compile /2 XMLConformance.Mod",
  "$compile /2 XMLStress.Mod",
  "XMLTests.Run",
  "tar.Unpack xmltest.tar.gz .",
  "tar.Unpack ibm.tar.gz .",
  "tar.Unpack sun.tar.gz .",
  "tar.Unpack oasis.tar.gz .",
  "tar.Unpack local.tar.gz .",
  "XMLConformance.Run wf.list canonical.list validation.list misc.list",
  "fs.Cd protocol",
  "XMLConformance.Run ../protocol.list",
  "fs.Cd ../namespaces",
  "XMLConformance.Run ../namespaces-protocol.list",
  "fs.Cd ..",
  "XMLStress.Fuzz",
  "XMLStress.Limits",
]


