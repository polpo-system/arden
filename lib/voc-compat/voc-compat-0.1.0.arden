[PACKAGE]
name        = "voc-compat"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Platform and Args with the interfaces of voc, for the modules shared with voc"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
console = "0.1.0"

[MODULES]
all = ["src/cli/Platform.Mod", "src/cli/Args.Mod"]
