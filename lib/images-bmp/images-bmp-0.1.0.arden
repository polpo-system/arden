[PACKAGE]
name        = "images-bmp"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "BMPImages: the BMP reader of Images"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/images-bmp/30dcf8d93614af93c7237c3a1cf47ed363ab71f9"
tag  = "v0.1.0"

[DEPS]
images = "0.1.0"

[MODULES]
all = ["src/BMPImages.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/BMPImagesTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/BMPImagesTest.Mod"]
cmds = ["$compile BMPImagesTest.Mod", "BMPImagesTest.Run"]
ok   = ["BMPImagesTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/BMPImages.Mod = "sha256:8415c2450eb5c430fe4f8669c11369b54ca20c7f177cfd5184f64875b4434b14"
test/BMPImagesTest.Mod = "sha256:872194b92c3a2c137e28692f2785a02f3c223ec61391f856e257ca7fcf1ed575"
README.md = "sha256:50edc9752c510e4576a175e47a2c4305e4a935df2b6f3297acc0ad7e1f80631c"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
