[PACKAGE]
name        = "images-psd"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "PSDImages: the Photoshop reader of Images"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/images-psd/68017890aae8affe1ab7c499510e9d5eee7eba91"
tag  = "v0.1.0"

[DEPS]
images = "0.1.0"

[MODULES]
all = ["src/PSD.Mod", "src/PSDImages.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/PSDImagesTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/PSDImagesTest.Mod"]
cmds = ["$compile PSDImagesTest.Mod", "PSDImagesTest.Run"]
ok   = ["PSDImagesTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/PSD.Mod = "sha256:8fa8bd4dc48686492936619e329acbe9b41d26dfbed2eb082514df2f3c20eed2"
src/PSDImages.Mod = "sha256:f271db19f14aa88f04cc049f4f5ee7a21610ac235dda95bcdf8b03636965f637"
test/PSDImagesTest.Mod = "sha256:1b2667f6c6b6cb4a71ffbe8f3de722761757aad783f658504bc99cc8602610e0"
README.md = "sha256:e308658a2b71ef3cf4462a2f761861cfa609a73fb9a6917e3d808e02825cbb9f"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
