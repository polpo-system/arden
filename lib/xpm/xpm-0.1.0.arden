[PACKAGE]
name        = "xpm"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "XPM: X pixmaps for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/eccffe4eed5fbb165588187fcc6ac6ce77843f03"
tag  = "eccffe4eed5fbb165588187fcc6ac6ce77843f03"

[DEPS]
desktop = "0.1.0"
colormodels = "0.1.0"

[MODULES]
all = ["src/XPM.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.xpm", "test/PictTest.Mod", "README.md", "LICENSE"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.xpm", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.xpm 64 48"]
ok   = ["PictTest: sample.xpm 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/XPM.Mod" = "sha256:152fbedaa23da5d5e6e2bc1e44b572d486bb95c378cddafb9217da1e71fccb0b"
"test/sample.xpm" = "sha256:b27cb03d3940912bece2551105108329794d7926262a614599b34ef2e94e8857"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:1a8e5a907f7695426e82fafda6b00984672a2a202e277c5d0fd49b355733b263"
"LICENSE" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
