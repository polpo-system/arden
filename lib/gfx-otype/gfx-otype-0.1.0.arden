[PACKAGE]
name        = "gfx-otype"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "GfxOType: OpenType fonts for Gfx"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gfx-otype/76b5320592ac8ba68c8f246062571ccfb624dd0d"
tag  = "v0.1.0"

[DEPS]
gfx = "0.1.0"
otype = "0.1.0"

[MODULES]
all = ["src/GfxOType.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/GfxOTypeTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/GfxOTypeTest.Mod"]
cmds = ["$compile GfxOTypeTest.Mod", "GfxOTypeTest.Run"]
ok   = ["GfxOTypeTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/GfxOType.Mod = "sha256:b9e1d750047bceac0120bdd6a203b6ba9afc4d6b8a9a3bf03e76328f7aad8f8d"
test/GfxOTypeTest.Mod = "sha256:a1ab947a7432b1b0523f505bbcaa9723d92fdd6e436f31ca8cf69a87e6ed8118"
README.md = "sha256:9a522566ef2e586acfeefe3dbc27f43ae2287ca2bf1ab4e18e48d2164ea53b1e"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
