[PACKAGE]
name        = "randomnumbers"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "RandomNumbers of ETH Oberon: uniform and exponential random numbers, seeded by the desktop's clock"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
desktop = "0.1.0"
math = "0.1.0"

[MODULES]
all = ["src/desktop/RandomNumbers.Mod"]
