[PACKAGE]
name        = "http"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "an HTTP/1.1 client, shared with voc"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
console = "0.1.0"
ooc = "0.1.0"
strutils = "0.1.0"
base64 = "0.1.0"
internet = "0.1.0"

[MODULES]
all = ["src/lib/http/hexIntStr.Mod", "src/lib/http/http.Mod"]
