[PACKAGE]
name        = "ooc-strings"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "LGPL-2+"
description = "strings of the OOC library 1.5 (as in voc): Ascii, CharClass, oocStrings, Strings2, OakStrings"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]

[MODULES]
all = [
  "src/lib/ooc/Ascii.Mod",
  "src/lib/ooc/CharClass.Mod",
  "src/lib/ooc/oocStrings.Mod",
  "src/lib/ooc/Strings2.Mod",
  "src/lib/ooc/OakStrings.Mod",
]
