[PACKAGE]
name        = "ico"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "ICO: Windows icons for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/eccffe4eed5fbb165588187fcc6ac6ce77843f03"
tag  = "eccffe4eed5fbb165588187fcc6ac6ce77843f03"

[DEPS]
desktop = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/ICO.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.ico", "test/PictTest.Mod", "README.md", "LICENSE"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.ico", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.ico 32 32"]
ok   = ["PictTest: sample.ico 32 x 32 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/ICO.Mod" = "sha256:14222a61a336421399c80cd7e691438de85efe660d8b4c8f9d7850e40d7e0638"
"test/sample.ico" = "sha256:395e27afdb18839ee670d8ceb9f3c8030bd5e2294f734543077a779dd2a3bcc4"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:1a8e5a907f7695426e82fafda6b00984672a2a202e277c5d0fd49b355733b263"
"LICENSE" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
