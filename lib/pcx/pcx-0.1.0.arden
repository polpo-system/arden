[PACKAGE]
name        = "pcx"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "PCX: PCX pictures (up to 256 colours) for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/eccffe4eed5fbb165588187fcc6ac6ce77843f03"
tag  = "eccffe4eed5fbb165588187fcc6ac6ce77843f03"

[DEPS]
desktop = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/PCX.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.pcx", "test/PictTest.Mod", "README.md", "LICENSE"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.pcx", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.pcx 64 48"]
ok   = ["PictTest: sample.pcx 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/PCX.Mod" = "sha256:17361022431416510b19bded0093f1f93571e4a4446825fb4eb543ba43d2c515"
"test/sample.pcx" = "sha256:7dff82a412b5665d3bf6f4b79e50e3013fb26f533c347d78839cd949de229c7d"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:1a8e5a907f7695426e82fafda6b00984672a2a202e277c5d0fd49b355733b263"
"LICENSE" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
