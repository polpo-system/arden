[PACKAGE]
name        = "pcx"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "PCX: PCX pictures (up to 256 colours) for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/5db84f8f772be2cf2812b47db32f4501454731ea"
tag  = "5db84f8f772be2cf2812b47db32f4501454731ea"

[DEPS]
desktop = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/PCX.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.pcx", "test/PictTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.pcx", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.pcx 64 48"]
ok   = ["PictTest: sample.pcx 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/PCX.Mod" = "sha256:17361022431416510b19bded0093f1f93571e4a4446825fb4eb543ba43d2c515"
"test/sample.pcx" = "sha256:7dff82a412b5665d3bf6f4b79e50e3013fb26f533c347d78839cd949de229c7d"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:0e543fc81cc742f87a1bc1577a72805c86a6ce5cc350877bb07323f73bf03cde"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"LICENSE.ETH" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
