[PACKAGE]
name        = "terminals"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "a VT100 terminal emulation and a frame for viewers (ETH Oberon)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/terminals/606b9394d443111a72ad23d5804e968456e056e5"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"

[MODULES]
all = ["src/Terminals.Mod", "src/TerminalFrames.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/TerminalsTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

[TESTS]
copy = ["test/TerminalsTest.Mod"]
cmds = ["$compile TerminalsTest.Mod", "TerminalsTest.Run"]
ok   = ["TerminalsTest: 5 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]

[SUMS]
src/Terminals.Mod = "sha256:61e24a5167ed023de58818ccb56c99b2535a18a76131d869351c7ca840bb7b81"
src/TerminalFrames.Mod = "sha256:57fd36fae35797d242caf5b27020a40a89555acb64930fb2c91ffdfe23d89f66"
test/TerminalsTest.Mod = "sha256:71c29efcded20a203cf23afb7e1c47343e2ca287f759b6f5c9a0e0148f7a5d06"
README.md = "sha256:94884fae2249cfb22bb6e46b5510fbbeb94892b9312edd090a9e58b19c3f0f48"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
