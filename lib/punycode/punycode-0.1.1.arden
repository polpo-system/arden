[PACKAGE]
name        = "punycode"
category    = "lib"
version     = "0.1.1"
author      = "Norayr Chilingarian (agena); the voc port; polpo"
license     = "GPL-3; Unicode and IDNA data: Unicode License, BSD-3-Clause"
description = "RFC 3492 Punycode, Unicode 16.0 NFC and IDNA host names (UTS #46, IDNA2008): IDNA.Names, from agena by way of the voc port"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/punycode/a784e86abbac38e388b0f4c663bc3d74db71a1f2"
tag  = "v0.1.1"

[DEPS]
console = "0.1.0"

[MODULES]
all = ["Punycode.Mod", "polpo/src/IDNAMapping.Mod", "polpo/src/IDNAData.Mod", "UnicodeNFC.Mod", "IDNA.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["polpo/data/IDNAMapping.txt=share/IDNAMapping.txt", "polpo/data/IDNAData.txt=share/IDNAData.txt",
  "polpo/tools/IDNATables.Mod", "README.md", "LICENSE", "NOTICE", "NOTICE-IDNA", "NOTICE-UNICODE",
  "tests/TestPunycode.Mod", "polpo/test/TestIDNA.Mod", "polpo/test/PunycodeTests.Mod",
  "polpo/test/PunycodeVectors.Mod", "polpo/test/vectors.tar.gz"]

[TESTS]
copy = ["tests/TestPunycode.Mod", "polpo/test/TestIDNA.Mod", "polpo/test/PunycodeTests.Mod",
  "polpo/test/PunycodeVectors.Mod", "polpo/test/vectors.tar.gz"]
cmds = ["$compile TestPunycode.Mod", "$compile TestIDNA.Mod", "$compile PunycodeTests.Mod",
  "$compile PunycodeVectors.Mod", "PunycodeTests.Run", "tar.Unpack vectors.tar.gz .",
  "PunycodeVectors.Run requests.txt output.txt"]
ok   = ["Punycode and Unicode NFC checks passed", "IDNA UTF-8 name checks passed: 38",
  "PunycodeTests: 2 test modules passed", "PunycodeVectors: 47844 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL", "not found"]

[SUMS]
Punycode.Mod = "sha256:1c64cb4054c4691d9dc7d4c9a694c89c7778a5fff3c4194401722f119ec4e820"
