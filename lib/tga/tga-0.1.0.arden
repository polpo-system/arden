[PACKAGE]
name        = "tga"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "TGA: Targa pictures (colour mapped, true colour, grey, RLE) for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/5db84f8f772be2cf2812b47db32f4501454731ea"
tag  = "5db84f8f772be2cf2812b47db32f4501454731ea"

[DEPS]
desktop = "0.1.0"

[MODULES]
all = ["src/TGA.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.tga", "test/PictTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.tga", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.tga 64 48"]
ok   = ["PictTest: sample.tga 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/TGA.Mod" = "sha256:9efa25948d4028f2861bb16275845e7c12a337d23e908981d62c9f82c56430f3"
"test/sample.tga" = "sha256:d36bb070cd5848a35ed01f9493544a06d84e4cdcd50d3efe6af89bf4f0ca6395"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:0e543fc81cc742f87a1bc1577a72805c86a6ce5cc350877bb07323f73bf03cde"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"LICENSE.ETH" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
