[PACKAGE]
name        = "tga"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "TGA: Targa pictures (colour mapped, true colour, grey, RLE) for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/eccffe4eed5fbb165588187fcc6ac6ce77843f03"
tag  = "eccffe4eed5fbb165588187fcc6ac6ce77843f03"

[DEPS]
desktop = "0.1.0"

[MODULES]
all = ["src/TGA.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.tga", "test/PictTest.Mod", "README.md", "LICENSE"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.tga", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.tga 64 48"]
ok   = ["PictTest: sample.tga 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/TGA.Mod" = "sha256:9efa25948d4028f2861bb16275845e7c12a337d23e908981d62c9f82c56430f3"
"test/sample.tga" = "sha256:d36bb070cd5848a35ed01f9493544a06d84e4cdcd50d3efe6af89bf4f0ca6395"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:1a8e5a907f7695426e82fafda6b00984672a2a202e277c5d0fd49b355733b263"
"LICENSE" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
