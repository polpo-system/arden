[PACKAGE]
name        = "gfx"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Gfx of ETH Oberon: two-dimensional graphics for screen, images and printers"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/gfx/cc259e33cdf8e6321d2b41d94be19d15f4484861"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"
desktop-tools = "0.1.0"
math = "0.1.0"
images = "0.1.0"

[MODULES]
all = ["src/GfxMatrix.Mod", "src/GfxImages.Mod", "src/GfxPaths.Mod", "src/GfxRegions.Mod", "src/OLR.GfxFonts0.Mod", "src/GfxFonts.Mod", "src/Gfx.Mod", "src/GfxRaster.Mod", "src/GfxDisplay.Mod", "src/GfxPrinter.Mod", "src/GfxBuffer.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/GfxHowto.html=share/GfxHowto.html", "share/GfxOverview.html=share/GfxOverview.html", "tools/Gfx.Tool=tools/Gfx.Tool", "test/GfxDrawTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/GfxDrawTest.Mod"]
cmds = ["$compile GfxDrawTest.Mod", "GfxDrawTest.Run"]
ok   = ["GfxDrawTest: 2 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
