[PACKAGE]
name        = "math"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Math and MathL (sin, cos, arctan, sqrt, ln, exp) of ETH Oberon: x87 on x86, portable elsewhere"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/math/4a12207d17ce74705305bcf40f06c2f8cc0082a0"
tag  = "4a12207d17ce74705305bcf40f06c2f8cc0082a0"

[DEPS]
core = "0.1.0"

[MODULES]
x86   = ["src/x86/Math.Mod", "src/x86/MathL.Mod"]
arm   = ["src/Math.Mod", "src/MathL.Mod"]
armv7 = ["src/Math.Mod", "src/MathL.Mod"]
riscv = ["src/Math.Mod", "src/MathL.Mod"]
mips  = ["src/Math.Mod", "src/MathL.Mod"]

[FILES]
all = ["test/MathTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

[TESTS]
copy = ["test/MathTest.Mod"]
cmds = ["$compile MathTest.Mod", "MathTest.Run"]
ok   = ["MathTest: 0 failed"]
bad  = ["TRAP", "  err "]

