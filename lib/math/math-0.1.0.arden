[PACKAGE]
name        = "math"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Math and MathL of ETH Oberon (sin, cos, arctan, sqrt, ln, exp): x87 on x86, portable elsewhere"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
core = "0.1.0"

[MODULES]
x86 = ["src/lib/math/x86/Math.Mod", "src/lib/math/x86/MathL.Mod"]
arm = ["src/lib/math/Math.Mod", "src/lib/math/MathL.Mod"]
riscv = ["src/lib/math/Math.Mod", "src/lib/math/MathL.Mod"]
mips = ["src/lib/math/Math.Mod", "src/lib/math/MathL.Mod"]
armv7 = ["src/lib/math/Math.Mod", "src/lib/math/MathL.Mod"]
