[PACKAGE]
name        = "bmp"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "BMP: BMP pictures with a palette for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/ef0af6ec8086d9d427d09f0b020a5e53cbc176ad"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"

[MODULES]
all = ["src/BMP.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.bmp", "test/PictTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.bmp", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.bmp 64 48"]
ok   = ["PictTest: sample.bmp 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/BMP.Mod" = "sha256:18048596c35c78c377b4e1a5f97ab73b3deec36f1087d22a27c1ff6c504c6312"
"test/sample.bmp" = "sha256:a769aa56f42b739a4de5ff0b3ba2fc8453d9fede6741713ed0602c60d989c5a1"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:0e543fc81cc742f87a1bc1577a72805c86a6ce5cc350877bb07323f73bf03cde"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"LICENSE.ETH" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
