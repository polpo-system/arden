[PACKAGE]
name        = "images-png"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "PNGImages: PNG pictures for Images, read and written"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/png-codec/335a528ba1b22cb9f6b212f4163cd0bd029440e0"
tag  = "v0.1.0"

[DEPS]
images = "0.1.0"
png-codec = "0.1.0"

[MODULES]
all = ["desktop/PNGImages.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/PNGImagesTest.Mod", "test/PngSuite-2017jul19.tgz"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/PNGImagesTest.Mod", "test/PngSuite-2017jul19.tgz"]
cmds = ["tar.Unpack PngSuite-2017jul19.tgz .", "$compile PNGImagesTest.Mod", "PNGImagesTest.Run"]
ok   = ["PNGImagesTest: 4 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true



[SUMS]
desktop/PNGImages.Mod = "sha256:36cf63217f63eace9c11b545a59a3ef032a06869a2f1c8a0a615abf1faf19d09"
test/PNGImagesTest.Mod = "sha256:d9fcbb7ef2ccd6820feca11da5cb874f1fa754b3c6ef47a800f0f9b183fb0568"
test/PngSuite-2017jul19.tgz = "sha256:0294b244c95a8342c01b00010cf34abdcabc7c6a34fd0fe1bd963917537bfdc8"
