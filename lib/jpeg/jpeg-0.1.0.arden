[PACKAGE]
name        = "jpeg"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "JPEG: baseline JPEG pictures for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/ef0af6ec8086d9d427d09f0b020a5e53cbc176ad"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/JPEG.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.jpg", "test/PictTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.jpg", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.jpg 64 48"]
ok   = ["PictTest: sample.jpg 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/JPEG.Mod" = "sha256:36d1d2f4886b0f28cb649b440b22506c17cf9edde6a9b6e5ddced618393861be"
"test/sample.jpg" = "sha256:84786ff002dcb5ee7f1c92cb3a408ff990e568e94587902f70a090ead8fa4ef2"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:0e543fc81cc742f87a1bc1577a72805c86a6ce5cc350877bb07323f73bf03cde"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"LICENSE.ETH" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
