[PACKAGE]
name        = "jpeg"
category    = "lib"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "JPEG: baseline JPEG pictures for Pictures and Iris"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/picture-formats/eccffe4eed5fbb165588187fcc6ac6ce77843f03"
tag  = "eccffe4eed5fbb165588187fcc6ac6ce77843f03"

[DEPS]
desktop = "0.1.0"
bit = "0.1.0"

[MODULES]
all = ["src/JPEG.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/sample.jpg", "test/PictTest.Mod", "README.md", "LICENSE"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/sample.jpg", "test/PictTest.Mod"]
cmds = ["$compile PictTest.Mod", "PictTest.Open sample.jpg 64 48"]
ok   = ["PictTest: sample.jpg 64 x 48 ok"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/JPEG.Mod" = "sha256:36d1d2f4886b0f28cb649b440b22506c17cf9edde6a9b6e5ddced618393861be"
"test/sample.jpg" = "sha256:84786ff002dcb5ee7f1c92cb3a408ff990e568e94587902f70a090ead8fa4ef2"
"test/PictTest.Mod" = "sha256:7acad9b46eff042a6bffeb7ef03f33283096ec975b33a04ae85bd32d340e5142"
"README.md" = "sha256:1a8e5a907f7695426e82fafda6b00984672a2a202e277c5d0fd49b355733b263"
"LICENSE" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
