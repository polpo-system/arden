[PACKAGE]
name        = "jpeg"
category    = "lib"
version     = "0.2.0"
author      = "polpo"
license     = "GPL-3"
description = "JPEG: JPEG pictures (baseline, progressive) for Pictures, WebNav and Iris; JPEG.Store writes them"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/jpeg-codec/84e0c1078089fdd7bed496fa423b2d22c8372c7e"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"
jpeg-codec = "0.1.0"
png = "0.1.0"

[MODULES]
all = ["desktop/JPEG.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/JPEGPicturesTest.Mod", "test/jpegsuite.tgz"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/JPEGPicturesTest.Mod", "test/jpegsuite.tgz"]
cmds = ["tar.Unpack jpegsuite.tgz .", "$compile JPEGPicturesTest.Mod", "JPEGPicturesTest.Run"]
ok   = ["JPEGPicturesTest: 4 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
desktop/JPEG.Mod = "sha256:bb11edef9c94cc74d6fd640e45b9ce216deecd406b55df931ecad8a6f55019ff"
test/JPEGPicturesTest.Mod = "sha256:3e77e63367e836793320887ef13de92bf82d367cc1c291404c12d3379a5aecf7"
test/jpegsuite.tgz = "sha256:0a42f0906eebc4f81655671c695e709050408dfe4a5f94fcee5f9b76e1feff89"
