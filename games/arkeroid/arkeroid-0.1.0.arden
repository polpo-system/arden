[PACKAGE]
name        = "arkeroid"
category    = "games"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Arkeroid: break the bricks with the ball, ten rounds drawn with Gfx over the screen (C. Hatz and D. Frank)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/arkeroid/4e6000aefbd800bc2dae0db3e835d6d16f85e8a7"
