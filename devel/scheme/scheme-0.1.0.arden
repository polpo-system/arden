[PACKAGE]
name        = "scheme"
category    = "devel"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Scheme: the Scheme interpreter of ETH Oberon System 3 (Erich Oswald, 2000): rationals, reals, ports"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/scheme/1bd6b64455bb057d02eaec532df74417e445274d"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"
desktop-tools = "0.1.0"
math = "0.1.0"

[MODULES]
all = ["src/Scheme.Mod", "src/SchemeOps.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["Scheme.Tool=tools/Scheme.Tool", "Scheme.Init=share/Scheme.Init", "test/SchemeTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SchemeTest.Mod"]
cmds = ["$compile SchemeTest.Mod", "SchemeTest.Run"]
ok   = ["SchemeTest: 19 checks, 0 failed"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"src/Scheme.Mod" = "sha256:9b8e6568770066f094f1ff1ea76642731d1d28b52550904f2b1607a185534806"
"src/SchemeOps.Mod" = "sha256:d0e902630bc4e5a08d8922508df98acf89ed3f95d02ae0c390ab1564047a870c"
"Scheme.Tool" = "sha256:6bd24235c165309b76aa6f1455e9630b7e2e44340a6f9fbff5eb468096774c48"
"Scheme.Init" = "sha256:218510d776a315e9b42c3931c43f86c6a87d12722d7f628b12ae6e3bf48bf5c3"
"test/SchemeTest.Mod" = "sha256:e35f63ba9072745f025403fde06726ac0c225922cf7a7504b62d2dd6b614d716"
"README.md" = "sha256:13f753718b6f8a5137eea74887a836cca45a7c51597b8103f54ac7b6b6aaa0d1"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"LICENSE.ETH" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
