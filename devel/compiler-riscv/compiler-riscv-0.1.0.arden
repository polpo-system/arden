[PACKAGE]
name        = compiler-riscv
category    = devel
version     = 0.1.0
author      = polpo
license     = ETH Oberon
description = "the RISC-V back end of ROP2"

[REMOTE]
type = git
uri  = https://github.com/norayr/polpo
tag  = main

[DEPS]
compiler-rop2 = 0.1.0

[MODULES]
x86 = "src/cli/riscv/VOPL.Mod src/cli/riscv/VOPC.Mod src/cli/riscv/VOPV.Mod src/cli/riscv/rvcompiler.Mod"
riscv = "src/cli/riscv/VOPL.Mod src/cli/riscv/VOPC.Mod src/cli/riscv/VOPV.Mod src/cli/riscv/rvcompiler.Mod src/cli/riscv/compiler.Mod src/cli/riscv/linker.Mod"

[FILES]
all = "tools/riscv.Tool"
