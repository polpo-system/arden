[PACKAGE]
name        = "lisp"
category    = "devel"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Lisp: Oberon Lisp of Oberon V4 (Robert Griesemer, ETH 1991), whole numbers of any size"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/lisp/5bf8ae8c20a78d06e696913d488a166a24aa384c"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"

[MODULES]
all = ["src/Integers.Mod", "src/Lisp.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Lisp.Tool=tools/Lisp.Tool", "test/LispTest.Mod", "README.md", "LICENSE", "LICENSE.ETH", "LICENSE.LGPL"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/LispTest.Mod"]
cmds = ["$compile LispTest.Mod", "LispTest.Run"]
ok   = ["LispTest: 12 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Integers.Mod = "sha256:39348bfab23662348b77d1a6908337cc4c356a54095445cdb7189d83fc9ba2c4"
src/Lisp.Mod = "sha256:fc4e70f43ac66056e1ce9b3347e7d486335abe24c7c839a6af7fe3deac0d9583"
tools/Lisp.Tool = "sha256:eb165f5e708846230020c381361ac6041d3ffb036d7a50f33021963956605c48"
test/LispTest.Mod = "sha256:f3edc92d102b0e5da04ab2912b3e14844e51c089f7c9ce1a59a95d29055bc688"
README.md = "sha256:619904a573516cda22f56605f33b0b756406665a9bee9ffa8041a0fce2dee816"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
LICENSE.LGPL = "sha256:512d2d21b6b3384ba64781abb0208a1b87740bc31e2df48e2b206ddb7e4d5779"
