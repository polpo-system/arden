[PACKAGE]
name        = "coco-eth"
category    = "devel"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Coco/R 2.2 of H. Moessenboeck as in Native Oberon 2.3.6, with Coco.Tool (desktop)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/coco-eth/72674585b50ad1a42e3bb674ea102cd480d060bf"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"

[CONFLICTS]
coco = "0.1.0"

[MODULES]
all = [
  "src/Sets.Mod",
  "src/CRS.Mod",
  "src/CRT.Mod",
  "src/CRA.Mod",
  "src/CRX.Mod",
  "src/CRP.Mod",
  "src/Coco.Mod",
]

# path in the repository, or path=destination in the polpo root
[FILES]
all = [
  "Parser.FRM=share/Parser.FRM",
  "Scanner.FRM=share/Scanner.FRM",
  "Coco.Tool=tools/Coco.Tool",
  "CR.ATG",
  "README.md",
  "LICENSE",
  "LICENSE.ETH",
]

# Coco/R generates its own scanner and parser, which are compiled; its messages go to the
# log of the desktop, so the test looks for compiler errors and missing files; it needs the
# desktop: DISPLAY set (an Xvnc will do)
[TESTS]
copy = ["CR.ATG"]
cmds = ["Coco.Compile CR.ATG", "$compile CRS.Mod", "$compile CRP.Mod"]
bad  = ["  err ", "not found", "TRAP"]
display = true

[SUMS]
