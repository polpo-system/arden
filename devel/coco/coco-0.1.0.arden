[PACKAGE]
name        = "coco"
category    = "devel"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "Coco/R, the compiler generator of H. Moessenboeck, as improved by A. V. Shiryaev (2012.01)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo-coco/32cd4e80ec11a329f1f4ef1678817b03b7cee940"
tag  = "32cd4e80ec11a329f1f4ef1678817b03b7cee940"

[DEPS]
console = "0.1.0"
desktop = "0.1.0"

[CONFLICTS]
coco-eth = "0.1.0"

[MODULES]
all = [
  "src/common/Sets.Mod",
  "src/common/CRS.Mod",
  "src/common/CRT.Mod",
  "src/common/CRA.Mod",
  "src/common/CRX.Mod",
  "src/common/CRP.Mod",
  "src/common/CRD.Mod",
  "src/cli/coco.Mod",
  "src/ui/Coco.Mod",
]

# path in the repository, or path=destination in the polpo root
[FILES]
all = [
  "Parser.FRM=share/Parser.FRM",
  "Scanner.FRM=share/Scanner.FRM",
  "Driver.FRM",
  "CR.ATG",
  "examples/A.ATG",
  "examples/A.ob",
  "README.md",
  "LICENSE",
]

# coco builds the compiler of examples/A.ATG, which is compiled and run
[TESTS]
copy = ["examples/A.ATG", "examples/A.ob", "Driver.FRM"]
cmds = [
  "coco.Compile A.ATG",
  "$compile AS.Mod",
  "$compile AP.Mod",
  "$compile ACompile.Mod",
  "ACompile.Do A.ob",
]
ok   = ["0 errors"]
bad  = ["TRAP"]

[SUMS]
