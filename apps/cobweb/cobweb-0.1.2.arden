[PACKAGE]
name        = "cobweb"
category    = "apps"
version     = "0.1.2"
author      = "polpo"
license     = "GPL-3"
description = "cobweb.Serve: an HTTP and HTTPS server for a directory, over the TLS 1.3 server of tls"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/cobweb/a86ed1550679a34b5c9013452fed6a5f8895c776"
tag  = "v0.1.2"

[DEPS]
console = "0.1.0"
sockets = "0.1.0"
tls = "0.1.0"

[MODULES]
all = ["cobweb.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE", "test/CobwebTest.Mod", "test/cert.pem", "test/key.pem", "test/index.html"]

[TESTS]
copy = ["test/CobwebTest.Mod", "test/cert.pem", "test/key.pem", "test/index.html"]
cmds = ["$compile CobwebTest.Mod", "CobwebTest.Run"]
ok   = ["status: HTTP/1.1 200 OK", "has: zq test site", "has: Content-Length: 30", "status: HTTP/1.1 404 Not Found", "has: Allow: GET, HEAD", "the HTTP server ended", "the HTTPS server ended"]
bad  = ["TRAP", "  err ", "missing", "no connection", "did not start", "server failed"]

[SUMS]
"cobweb.Mod" = "sha256:904be992632c41ae181c7616fc3d2fd40f3d10fe2612152f529194e4546bb367"
"README.md" = "sha256:1b00862a212c37cc1424898ce5d1d72d36227542c4dc9bd8783110f9e2503e83"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"test/CobwebTest.Mod" = "sha256:6297a18dafc97b2075650cb05258f72b7ae2458ee678cc500d3e0048040d9bf5"
"test/cert.pem" = "sha256:1c43f28dd99b2a9c77d9fbdb41cb1193d469b8237b8e6b4b98a04c0e8e774611"
"test/key.pem" = "sha256:b8a6db35af3f4574c71ce623453475061b7459ef4add8dd63eead5773682be15"
"test/index.html" = "sha256:6b537439bba9c0c6b1efc92aba47747267ce81381ec0717c8124a634dd26a9e4"
