[PACKAGE]
name        = "binhex"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "binhex: decoding BinHex 4.0 (.hqx) files in the console"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/binhex/ec53df292d171b4c6f912022cac01de278d7aa38"
tag  = "ec53df292d171b4c6f912022cac01de278d7aa38"

[DEPS]
console = "0.1.0"

[MODULES]
all = ["BinHex0.Mod", "binhex.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/mkhqx.py", "test/sample.bin", "test/sample.hqx", "test/BinHexTest.Mod", "README.md", "LICENSE"]

[TESTS]
copy = ["test/sample.bin", "test/sample.hqx", "test/BinHexTest.Mod"]
cmds = ["binhex.Decode out.bin sample.hqx", "$compile BinHexTest.Mod", "BinHexTest.Compare out.bin sample.bin"]
ok   = ["binhex: out.bin, 2581 bytes", "BinHexTest: 2581 bytes, same"]
bad  = ["TRAP", "  err "]

[SUMS]
"BinHex0.Mod" = "sha256:91cca2903c2453c5eb88d6272157655808d4cea92dea0a8b53ec954d25b714c4"
"binhex.Mod" = "sha256:2faf1ba8233338cf6bad0d8cab90869f9c9499de24953590c16d3b57e4d39a39"
"test/mkhqx.py" = "sha256:9d47dc190f45e9dd0ed4724fe415871770718629b4692084257c4bc8cc1c1e3e"
"test/sample.bin" = "sha256:6992b176cfe85e70bfdbed6c8b6ca2a2fe1c4da23012572720a3208005047a6b"
"test/sample.hqx" = "sha256:4c64a634d3e9cd397ea181d893a1f70919019694870da4968e348d8917483a3c"
"test/BinHexTest.Mod" = "sha256:8ca10f1a79a5609528b3268b19f95fbc535af44c3cc329cfc11d9e218e350fe4"
"README.md" = "sha256:220430a598e4e75fb49a9ff4f68209ae42b93da49c4680122c9d97893ccb86a7"
"LICENSE" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
