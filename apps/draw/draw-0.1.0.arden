[PACKAGE]
name        = "draw"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Draw: the line drawing editor of ETH Oberon (lines, captions, macros, circles, splines)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/draw/a0f4c9107110b7b81b5399913289ea1630ba7c33"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"

[MODULES]
all = ["src/Graphics.Mod", "src/GraphicFrames.Mod", "src/Draw.Mod", "src/Rectangles.Mod", "src/Curves.Mod", "src/Splines.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["Draw.Tool=tools/Draw.Tool", "DrawGuide.Text=tools/DrawGuide.Text", "share/TTL0.Lib=share/TTL0.Lib", "share/TTL1.Lib=share/TTL1.Lib", "share/TTL0.Graph=share/TTL0.Graph", "share/TTL1.Graph=share/TTL1.Graph", "share/Elektra.Graph=share/Elektra.Graph", "fonts/Elektra.Scn.Fnt=fonts/Elektra.Scn.Fnt", "test/DrawTest.Mod", "test/sample.Graph", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/DrawTest.Mod", "test/sample.Graph"]
cmds = ["$compile DrawTest.Mod", "DrawTest.Run sample.Graph", "DrawTest.Run TTL0.Graph"]
ok   = ["DrawTest: sample.Graph lines 2 captions 29 macros 1 curves 3 rectangles 1 splines 1 ok", "DrawTest: TTL0.Graph lines 7 captions 65 macros 56 curves 0 rectangles 0 splines 0 ok"]
bad  = ["TRAP", "  err ", "wrong", "does not load"]
display = true

[SUMS]
