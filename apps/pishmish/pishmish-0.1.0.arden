[PACKAGE]
name        = "pishmish"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Pishmish: a Gemini and Spartan browser in the desktop, links followed by a click, identities"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
gemini-core = "0.1.0"
desktop = "0.1.0"

[MODULES]
all = ["src/desktop/Pishmish.Mod"]

[FILES]
all = ["tools/Pishmish.Tool"]
