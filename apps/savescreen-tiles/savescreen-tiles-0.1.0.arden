[PACKAGE]
name        = "savescreen-tiles"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "SaveTiles: a fader of SaveScreen"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/savescreen-tiles/d43936b0b286321eadae79a352cae1060c0a19d8"
tag  = "v0.1.0"

[DEPS]
savescreen = "0.1.0"

[MODULES]
all = ["src/SaveTiles.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/SaveTilesTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SaveTilesTest.Mod"]
cmds = ["$compile SaveTilesTest.Mod", "SaveTilesTest.Run"]
ok   = ["SaveTilesTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/SaveTiles.Mod = "sha256:9688fb294e0b059face13f1a9c987e06821193167fe72f2078860227514e86bd"
test/SaveTilesTest.Mod = "sha256:3a1c2817f5feb04d209b29b96d223121f7bb51e27dacb4bff33f157c49f00cf2"
README.md = "sha256:087388629863dce6cea9d95819922dd2a8ef7df97684b6d6ce9797464bf5ab10"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
