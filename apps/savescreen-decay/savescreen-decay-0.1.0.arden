[PACKAGE]
name        = "savescreen-decay"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "SaveDecay: a fader of SaveScreen"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/savescreen-decay/0c75d7ddcefe7ada2059125d94c30607965a1323"
tag  = "v0.1.0"

[DEPS]
savescreen = "0.1.0"

[MODULES]
all = ["src/SaveDecay.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/SaveDecayTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SaveDecayTest.Mod"]
cmds = ["$compile SaveDecayTest.Mod", "SaveDecayTest.Run"]
ok   = ["SaveDecayTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/SaveDecay.Mod = "sha256:5eab25ac6cc839be965ddbe976a33c3a507f6a70a12e8ac967e27817f18481fb"
test/SaveDecayTest.Mod = "sha256:a576ba49dececddf921273df67792aca8586b879537dc4a8c726f888b97c44c4"
README.md = "sha256:182d49dbbb132d01b514466a2c3cb23bc62e560b6247eff847c07ef576c5b18a"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
