[PACKAGE]
name        = "savescreen-particles"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "SaveParticles: a fader of SaveScreen"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/savescreen-particles/1812bf9bbf5a560d27424116fa578ee2103feffb"
tag  = "v0.1.0"

[DEPS]
savescreen = "0.1.0"

[MODULES]
all = ["src/SaveParticles.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["test/SaveParticlesTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SaveParticlesTest.Mod"]
cmds = ["$compile SaveParticlesTest.Mod", "SaveParticlesTest.Run"]
ok   = ["SaveParticlesTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/SaveParticles.Mod = "sha256:a328c19d0642aea6c87abcc2f3c228dfcb7367ad19782ab6464b35a61bb3c54c"
test/SaveParticlesTest.Mod = "sha256:26d549f7f9186d37f1cf1ac2fcc44ae322c6dead8be068f9ba9c8633f0d8e8df"
README.md = "sha256:3b835ccec6afb7646f03405c9c4f7b582d1c1ac08b4e306838a5eddb8d307f91"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
