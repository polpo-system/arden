src/SSHAuth.Mod = "sha256:e989b6ff912837768505337780a315fab0d52cf7686eee9d3be516d95239dd8c"
src/SSHChannels.Mod = "sha256:f70d1b86b7b555233b040fbf9ad43a45e4f2a3e90188b5658b0d7cccdb371c5a"
src/ssh.Mod = "sha256:3bd0c73cb77d7a5a8249693c22c88647488e4c7271fc655e83644faf536ae6f2"
README.md = "sha256:226304025fb4b60f43d8edc91f51fe2b156f0ee7da44a93fdca312f700a99f5c"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
