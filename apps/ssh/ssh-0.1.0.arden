[PACKAGE]
name        = "ssh"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "ssh.Exec and ssh.Connect: an SSH client (curve25519-sha256, Ed25519/ECDSA/RSA host keys, aes128-gcm, Ed25519 keys and passwords) on the tls library"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/ssh/e8558fb9ef696a67f164f6b7b60a63a6054a7c80"
tag  = "v0.1.0"

[DEPS]
console = "0.1.0"
unixnet = "0.1.0"
internet = "0.1.0"
tls = "0.1.0"

[MODULES]
all = ["src/SSHWire.Mod", "src/SSHKeys.Mod", "src/SSHTransport.Mod", "src/SSHAuth.Mod", "src/SSHChannels.Mod", "src/ssh.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE", "test/SSHTest.Mod", "test/msg.txt", "test/msg-ed25519.sig", "test/msg-ecdsa.sig", "test/msg-rsa.sig"]

[TESTS]
copy = ["test/SSHTest.Mod", "test/msg.txt", "test/msg-ed25519.sig", "test/msg-ecdsa.sig", "test/msg-rsa.sig"]
cmds = ["$compile SSHTest.Mod", "SSHTest.Run"]
ok   = ["SSHTest: 39 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]

[SUMS]
src/SSHWire.Mod = "sha256:db97d6072b6f00d338cc9465562d8dbcaf39af0bb851fa881d554cacb443f251"
src/SSHKeys.Mod = "sha256:e81f76dc10ad8ca75e5396c4acc0373db8da12cefac77d80025dbc842abdf619"
