[PACKAGE]
name        = "sound"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "sound.Play, Tone, Record, Mixer: WAV files, tones and the mixer through ALSA (else OSS), no C library; Sound0 and Wave0 for programs"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/sound/c8fc2edb05659c97ff7246a1d3ef7d91b8acbad6"
tag  = "v0.1.0"

[DEPS]
console = "0.1.0"
math = "0.1.0"

[MODULES]
all = ["src/Sound0.Mod", "src/Wave0.Mod", "src/sound.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE", "LICENSE.ETH", "test/SoundTest.Mod"]

# the device may be busy or missing on a test machine: the checks without it
[TESTS]
copy = ["test/SoundTest.Mod"]
cmds = ["$compile SoundTest.Mod", "SoundTest.Offline"]
ok   = ["SoundTest: 21 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]

[SUMS]
src/Sound0.Mod = "sha256:5563f0d563dadaf24419f96c18c37b8bc741498501d5a275b7b23b036d7f9786"
src/Wave0.Mod = "sha256:8fe4f1fcf64adfa793513afffef6833a16502eb01577b2f614e828de7264ea7e"
src/sound.Mod = "sha256:f2b1a349e4b6e7c4261c7a59b6c42d588519315edf78335481d98e020465dd57"
README.md = "sha256:9606ac9945b3b2d62c803309a1397db5ab3c8c4bcc4a23224947f60f8218840f"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
test/SoundTest.Mod = "sha256:57b1996e5e89f0a1a100c65f78c3fc27d1cf2faea979233762dd0e942d7ab92c"
