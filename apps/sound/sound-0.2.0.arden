[PACKAGE]
name        = "sound"
category    = "apps"
version     = "0.2.0"
author      = "polpo"
license     = "GPL-3"
description = "sound.Play, Tone, Record, Mixer: WAV and MP3 files, tones and the mixer through ALSA (else OSS), no C library; Sound0, Wave0 and MPEGAudio0 for programs"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/sound/45f00ba3910b4af0998ffb047c111d39f78b3844"
tag  = "v0.2.0"

[DEPS]
console = "0.1.0"
math = "0.1.0"

[MODULES]
all = ["src/Sound0.Mod", "src/Wave0.Mod", "src/MPEGAudio0.Mod", "src/sound.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["a2/MP3Huffman.Bin=share/MP3Huffman.Bin", "README.md", "LICENSE", "LICENSE.ETH", "LICENSE.A2", "test/SoundTest.Mod", "test/sound-mpeg1.mp3", "test/sound-mpeg1.wav", "test/sound-mpeg2.mp3", "test/sound-mpeg2.wav", "test/sound-mpeg25.mp3", "test/sound-mpeg25.wav", "test/sound-short.mp3", "test/sound-short.wav"]

# the device may be busy or missing on a test machine: the checks without it
[TESTS]
copy = ["test/SoundTest.Mod", "test/sound-mpeg1.mp3", "test/sound-mpeg1.wav", "test/sound-mpeg2.mp3", "test/sound-mpeg2.wav", "test/sound-mpeg25.mp3", "test/sound-mpeg25.wav", "test/sound-short.mp3", "test/sound-short.wav"]
cmds = ["$compile SoundTest.Mod", "SoundTest.Offline"]
ok   = ["SoundTest: 29 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]

