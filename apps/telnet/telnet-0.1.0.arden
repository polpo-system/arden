[PACKAGE]
name        = "telnet"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "a telnet client in a viewer of the desktop (ETH Oberon)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/telnet/0faa70b6b18655bdf31385885a71e0d96086b9eb"
tag  = "v0.1.0"

[DEPS]
desktop = "0.1.0"
terminals = "0.1.0"
netsystem = "0.1.0"

[MODULES]
all = ["src/Telnet.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["tools/Telnet.Tool=tools/Telnet.Tool", "test/TelnetTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/TelnetTest.Mod"]
cmds = ["$compile TelnetTest.Mod", "TelnetTest.Run"]
ok   = ["TelnetTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/Telnet.Mod = "sha256:34d382012b376c8a1480085ef4bcf622694f3c9413f59c9334dace0e26e4b1dd"
tools/Telnet.Tool = "sha256:8b45429d8ffd133d835dde38304df460a474c219e66291435ccfb0cdc51804c5"
test/TelnetTest.Mod = "sha256:1f6c99e35a7bb37235d8dd20347e02b1f5e3547ea0f4e791c59b1230a1bcb128"
README.md = "sha256:3570af9f7456ca2e9a39837360af94469968345eb17cfeb6daf97ba6d5e211f8"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
