[PACKAGE]
name        = "iris"
category    = "apps"
version     = "0.1.1"
author      = "polpo"
license     = "GPL-3"
description = "Iris: a picture viewer for the desktop (.pic, and the picture formats installed)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/iris/f505af6963fada2dca981f5d10abfbe96a7e8f70"
tag  = "v0.1.1"

[DEPS]
desktop = "0.1.0"
gif = "0.1.0"
jpeg = "0.1.0"
bmp = "0.1.0"
tga = "0.1.0"
pcx = "0.1.0"
ico = "0.1.0"
iff = "0.1.0"
xpm = "0.1.0"

[MODULES]
all = ["Iris.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["Iris.Tool=tools/Iris.Tool", "test/IrisTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/IrisTest.Mod"]
cmds = ["$compile IrisTest.Mod", "IrisTest.Run", "Iris.Open t.pic"]
ok   = ["IrisTest: 0 failed"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
Iris.Mod = "sha256:77e18f15b2aa1c698b3acdd75ba9cf34975e8c0ac90ff972f84da0ac1997e4f0"
Iris.Tool = "sha256:5c9dd7f68135eedc409e0b4e1853bf6b595b8e891ee30b351c8a752facbc26fa"
test/IrisTest.Mod = "sha256:091bcea7fe6b9aa8e57dc6ad23cf25d547aed6512732ebd39e714b3b080861dd"
README.md = "sha256:41028194e5174a279def9c3e15674a420625207be5452e73545c8df40732c2f2"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
