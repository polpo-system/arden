[PACKAGE]
name        = "iris"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Iris: a picture viewer for the desktop (.pic, and the picture formats installed)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/iris/9c84d3e3aac89d22e5e7ef392ceea111d81d4aa4"
tag  = "9c84d3e3aac89d22e5e7ef392ceea111d81d4aa4"

[DEPS]
desktop = "0.1.0"

[MODULES]
all = ["Iris.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["Iris.Tool=tools/Iris.Tool", "test/IrisTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/IrisTest.Mod"]
cmds = ["$compile IrisTest.Mod", "IrisTest.Run", "Iris.Open t.pic"]
ok   = ["IrisTest: 0 failed"]
bad  = ["TRAP", "  err "]
display = true

[SUMS]
"Iris.Mod" = "sha256:77e18f15b2aa1c698b3acdd75ba9cf34975e8c0ac90ff972f84da0ac1997e4f0"
"Iris.Tool" = "sha256:5b302f21908cd554c3148c5c2a5e8ee41acd81487c1fa7d429b200722b607b46"
"test/IrisTest.Mod" = "sha256:091bcea7fe6b9aa8e57dc6ad23cf25d547aed6512732ebd39e714b3b080861dd"
"README.md" = "sha256:c03847d47c72dcce99137112039cc0bc2bfb9506160586dcee345aba27918541"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"LICENSE.ETH" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
