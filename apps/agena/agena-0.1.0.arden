[PACKAGE]
name        = "agena"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "agena.Serve: a Gemini server for a directory, over the TLS 1.3 server of tls"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
console = "0.1.0"
sockets = "0.1.0"
tls = "0.1.0"

[MODULES]
all = ["src/cli/agena.Mod"]
