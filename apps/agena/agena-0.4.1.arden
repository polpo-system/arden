[PACKAGE]
name        = "agena"
category    = "apps"
version     = "0.4.1"
author      = "polpo"
license     = "GPL-3"
description = "agena.Serve: a Gemini server for a directory or several virtual hosts (TOML), on chosen IPv4 and IPv6 addresses, over the TLS 1.3 server of tls; host names through IDNA (punycode)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/agena/b610a7c21505586aa4c4efe553f17496ee7a3903"
tag  = "v0.4.1"

[DEPS]
console = "0.1.0"
sockets = "0.1.0"
tls = "0.1.0"
toml = "0.1.0"
punycode = "0.1.0"

[MODULES]
all = ["agena.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE", "agena.toml.example", "test/AgenaTest.Mod", "test/cert.pem", "test/key.pem", "test/index.gmi",
  "test/agena.toml", "test/one.gmi", "test/two.gmi", "test/x.zq"]

[TESTS]
copy = ["test/AgenaTest.Mod", "test/cert.pem", "test/key.pem", "test/index.gmi", "test/agena.toml", "test/one.gmi", "test/two.gmi", "test/x.zq"]
cmds = ["$compile AgenaTest.Mod", "AgenaTest.Run", "AgenaTest.Hosts", "AgenaTest.Names", "AgenaTest.Listen"]
ok   = ["status: 20 text/gemini; charset=utf-8", "body: zq test capsule", "status: 51 not found", "status: 53 proxy request refused", "the server ended",
  "body: page one", "body: page two", "status: 20 text/x-zq", "name: xn--y9a5bft.xn--y9a3aq", "name: xn--bcher-kva.example", "name: xn--fa-hia.de", "status: 59 bad request",
  "not listening: 127.0.0.1 on the port of ::1"]
bad  = ["TRAP", "  err ", "missing", "no connection", "did not start", "server failed"]

[SUMS]
agena.Mod = "sha256:ea2bc74c53a877e1af8dfda812ef88404957f1650bd858e88a2c83a5a59f36b5"
README.md = "sha256:a11d227e0b8f8f744a2d26eb3f4a4df32b24ce7143f4e10b86b1293477e89296"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
agena.toml.example = "sha256:13b0e59b0510a7a7ad0674e3633033f770d17b60fca79c1c044dde49e844fa45"
test/AgenaTest.Mod = "sha256:0fa12e1dee55fdea37a3b706e09812ebf03a7b845dab3fc92694d7f2aff07535"
test/cert.pem = "sha256:1c43f28dd99b2a9c77d9fbdb41cb1193d469b8237b8e6b4b98a04c0e8e774611"
test/key.pem = "sha256:b8a6db35af3f4574c71ce623453475061b7459ef4add8dd63eead5773682be15"
test/index.gmi = "sha256:949cb964380bf64834f5e043ec835b864482ddb4c2c8e0d2b922a8d2d176a491"
test/agena.toml = "sha256:c438792ca23d48816492bd45e50ca28e309d860872ebb18102e64107e0ef95ee"
test/one.gmi = "sha256:6f31f8466abdcfb2e163e0082cadc49664059f5950873b6871c8820732b5bbe2"
