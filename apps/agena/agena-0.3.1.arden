[PACKAGE]
name        = "agena"
category    = "apps"
version     = "0.3.1"
author      = "polpo"
license     = "GPL-3"
description = "agena.Serve: a Gemini server for a directory or several virtual hosts (TOML), on chosen IPv4 and IPv6 addresses, over the TLS 1.3 server of tls"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/agena/d3bfb6197b00425dd6a5bc93fd5cf640267f5eca"
tag  = "v0.3.1"

[DEPS]
console = "0.1.0"
sockets = "0.1.0"
tls = "0.1.0"
toml = "0.1.0"

[MODULES]
all = ["agena.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE", "agena.toml.example", "test/AgenaTest.Mod", "test/cert.pem", "test/key.pem", "test/index.gmi",
  "test/agena.toml", "test/one.gmi", "test/two.gmi", "test/x.zq"]

[TESTS]
copy = ["test/AgenaTest.Mod", "test/cert.pem", "test/key.pem", "test/index.gmi", "test/agena.toml", "test/one.gmi", "test/two.gmi", "test/x.zq"]
cmds = ["$compile AgenaTest.Mod", "AgenaTest.Run", "AgenaTest.Hosts", "AgenaTest.Names", "AgenaTest.Listen"]
ok   = ["status: 20 text/gemini; charset=utf-8", "body: zq test capsule", "status: 51 not found", "status: 53 proxy request refused", "the server ended",
  "body: page one", "body: page two", "status: 20 text/x-zq", "name: xn--y9a5bft.xn--y9a3aq", "name: xn--bcher-kva.example",
  "not listening: 127.0.0.1 on the port of ::1"]
bad  = ["TRAP", "  err ", "missing", "no connection", "did not start", "server failed"]

[SUMS]
"agena.Mod" = "sha256:db95dc4d2f10335abf5bceebc066b90d8272f99d0b7add96a6c8659aa421c45b"
"README.md" = "sha256:a3aa9d8bd008d6e3f693f841e179c6414b5b1ac6cf8baf745d554b89717e6532"
