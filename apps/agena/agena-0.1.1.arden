[PACKAGE]
name        = "agena"
category    = "apps"
version     = "0.1.1"
author      = "polpo"
license     = "GPL-3"
description = "agena.Serve: a Gemini server for a directory, over the TLS 1.3 server of tls"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/agena/64d615229eda14b672b43f113e7347706e8cb536"
tag  = "v0.1.1"

[DEPS]
console = "0.1.0"
sockets = "0.1.0"
tls = "0.1.0"

[MODULES]
all = ["agena.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE", "test/AgenaTest.Mod", "test/cert.pem", "test/key.pem", "test/index.gmi"]

[TESTS]
copy = ["test/AgenaTest.Mod", "test/cert.pem", "test/key.pem", "test/index.gmi"]
cmds = ["$compile AgenaTest.Mod", "AgenaTest.Run"]
ok   = ["status: 20 text/gemini; charset=utf-8", "body: zq test capsule", "status: 51 not found", "status: 53 proxy request refused", "the server ended"]
bad  = ["TRAP", "  err ", "missing", "no connection", "did not start", "server failed"]

[SUMS]
"agena.Mod" = "sha256:11b04733645c3a12a8fd4f34bc65450f633aa7a7fda83a57a7f1d77272c3cce8"
"README.md" = "sha256:dc4e5e321aee62c1fb76b9433cb641982167c0f20138c46ab640fef604e2b87a"
"LICENSE" = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
"test/AgenaTest.Mod" = "sha256:271d8e12cf13c6379921234209f62cea9777c0c5dc62522a1a088a7994d3e7db"
"test/cert.pem" = "sha256:1c43f28dd99b2a9c77d9fbdb41cb1193d469b8237b8e6b4b98a04c0e8e774611"
"test/key.pem" = "sha256:b8a6db35af3f4574c71ce623453475061b7459ef4add8dd63eead5773682be15"
"test/index.gmi" = "sha256:949cb964380bf64834f5e043ec835b864482ddb4c2c8e0d2b922a8d2d176a491"
