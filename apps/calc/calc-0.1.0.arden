[PACKAGE]
name        = "calc"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "calc: the Oberon calculator in the console (calc.Dec 2^10, calc.Hex ...)"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/calc/dbafa40ebc51a201135e67ad716cd5273f6b6a8a"
tag  = "dbafa40ebc51a201135e67ad716cd5273f6b6a8a"

[DEPS]
console = "0.1.0"
math = "0.1.0"

[MODULES]
all = ["Calc0.Mod", "calc.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["README.md", "LICENSE"]

[TESTS]
cmds = ["calc.Set alpha := 33H beta := 1000H ~", "calc.Hex alpha + beta", "calc.Dec 1000*sqrt 2", "calc.Char \"j\" + 7"]
ok   = ["Calc.Hex 1033H", "Calc.Dec 1414", "Calc.Char \"q\""]
bad  = ["TRAP", "  err "]

[SUMS]
"Calc0.Mod" = "sha256:b8225bb689a75b8e8f4ff1020d44cf745947bd0ac6245483b2f70845c34171f7"
"calc.Mod" = "sha256:06b608d0d6a81a7fd0aee2aa55befa0f7cabce62f4fea3d7d44293eaae9a2081"
"README.md" = "sha256:dbf4491c1cdcb5d73ead944a0d226e6cf93a01ffe6aad8ad83d12eb67df31c9a"
"LICENSE" = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
