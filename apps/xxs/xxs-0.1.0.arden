[PACKAGE]
name        = "xxs"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "a nano-like console editor for plain files and Oberon texts"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
console = "0.1.0"

[MODULES]
all = ["src/cli/xxs.Mod"]
