[PACKAGE]
name        = "savescreen-life"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "SaveLife: a fader of SaveScreen"

[REMOTE]
type = "files"
uri  = "https://raw.githubusercontent.com/polpo-system/savescreen-life/089489287babe9a9717f5d929d7749265a68081d"
tag  = "v0.1.0"

[DEPS]
savescreen = "0.1.0"
math = "0.1.0"

[MODULES]
all = ["src/SaveLife.Mod"]

# path in the repository, or path=destination in the polpo root
[FILES]
all = ["share/SaveLife.gif=share/SaveLife.gif", "share/SaveLife.html=share/SaveLife.html", "test/SaveLifeTest.Mod", "README.md", "LICENSE", "LICENSE.ETH"]

# the tests need the desktop (DISPLAY set; an Xvnc will do)
[TESTS]
copy = ["test/SaveLifeTest.Mod"]
cmds = ["$compile SaveLifeTest.Mod", "SaveLifeTest.Run"]
ok   = ["SaveLifeTest: 1 checks, 0 failed"]
bad  = ["TRAP", "  err ", "FAIL"]
display = true

[SUMS]
src/SaveLife.Mod = "sha256:d915d4625af527c905e589628cc63a5dda2610bd86484bf6a62a7487c12d0426"
share/SaveLife.gif = "sha256:888989f30c9f40a0e3784e678f07f78134e541e2e2f109d5572f32e8f47944e5"
share/SaveLife.html = "sha256:24f4b1f51ad252c16118b8080b992b593b6646c3834c599e227ffdee05bb6441"
test/SaveLifeTest.Mod = "sha256:f27c5f472c9f16de2fba31b8218173d61ae186ff491bb3dfbc1bd14570694504"
README.md = "sha256:bbc48fcd779516c0677dd8164b7d4d28304f9bd9b0521ca1944ed7145b091411"
LICENSE = "sha256:3972dc9744f6499f0f9b2dbf76696f2ae7ad8af9b23dde66d6af86c9dfb36986"
LICENSE.ETH = "sha256:4b6e996eef6dad163e58932a117f614bc171916883e0d9c776d6247dee8b2d81"
