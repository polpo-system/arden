[PACKAGE]
name        = "asciicoder-desktop"
category    = "apps"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "AsciiCoder: coding texts and files in the desktop"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
asciicoder = "0.1.0"
desktop = "0.1.0"

[MODULES]
all = ["src/desktop/AsciiCoder.Mod"]
