[PACKAGE]
name        = desktop-compiler-x86
version     = 0.1.0
author      = polpo
license     = ETH Oberon
description = "the x86 compiler, boot linker, decoder and browser in the desktop"

[REMOTE]
type = git
uri  = https://github.com/norayr/polpo
tag  = main

[DEPS]
desktop-tools = 0.1.0
compiler-x86 = 0.1.0

[MODULES]
x86 = "src/desktop/x86/XCompiler.Mod src/desktop/x86/XBootLinker.Mod src/desktop/x86/XDecoder.Mod src/desktop/x86/XBrowser.Mod"
