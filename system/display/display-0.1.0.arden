[PACKAGE]
name        = "display"
category    = "system"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "Display and Input: an X11 window, or the screen through KMS or the framebuffer"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
console-base = "0.1.0"

[CONFLICTS]
display-sixel = "0.1.0"

[MODULES]
all = ["/x src/desktop/POLPO.Display.Mod", "src/desktop/POLPO.Input.Mod"]
