[PACKAGE]
name        = "display-x11"
category    = "system"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "Display and Input for X11"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
desktop-base = "0.1.0"

[PROVIDES]
display = "0.1.0"

[CONFLICTS]
display-sixel = "0.1.0"

[MODULES]
all = ["/x src/desktop/POLPO.Display.Mod", "src/desktop/POLPO.Input.Mod"]
