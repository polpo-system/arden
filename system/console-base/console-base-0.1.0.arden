[PACKAGE]
name        = "console-base"
category    = "system"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "below the console and the display: modules, objects, texts in memory, command parameters"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
core = "0.1.0"
ooc-strings = "0.1.0"

[MODULES]
all = [
  "src/cli/out.Mod",
  "src/common/Modules.Mod",
  "src/common/Objects0.Mod",
  "src/cli/objects.Mod",
  "src/common/regex.Mod",
  "src/common/Utf8.Mod",
  "src/common/Texts0.Mod",
  "src/common/RXA.Mod",
  "src/common/Oberon0.Mod",
  "src/cli/texts.Mod",
  "src/desktop/POLPO.Objects.Mod",
  "src/desktop/POLPO.FileDir.Mod",
]
