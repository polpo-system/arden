[PACKAGE]
name        = "desktop-system"
category    = "system"
version     = "0.1.0"
author      = "polpo"
license     = "ETH Oberon"
description = "the System module of the desktop"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
desktop = "0.1.0"

[MODULES]
x86 = ["src/desktop/POLPO.System.Mod"]
arm = ["src/desktop/POLPO.System.Mod"]
riscv = ["src/desktop/rop2/POLPO.System.Mod"]
mips = ["src/desktop/rop2/POLPO.System.Mod"]
armv7 = ["src/desktop/rop2/POLPO.System.Mod"]
