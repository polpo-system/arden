[PACKAGE]
name        = "portia"
category    = "system"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "portia, the package manager"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
console = "0.1.0"
toml = "0.1.0"
versions = "0.1.0"
checksums = "0.1.0"

[MODULES]
all = ["src/cli/portia.Mod"]
