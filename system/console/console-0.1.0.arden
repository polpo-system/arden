[PACKAGE]
name        = "console"
category    = "system"
version     = "0.1.0"
author      = "polpo"
license     = "GPL-3"
description = "the console: shell, Texts and fonts, terminal, Oberon.Text"

[REMOTE]
type = "git"
uri  = "https://raw.githubusercontent.com/polpo-system/polpo/main"
tag  = "main"

[DEPS]
console-base = "0.1.0"
display = "0.1.0"

[MODULES]
all = [
  "src/desktop/POLPO.Fonts.Mod",
  "src/desktop/POLPO.Texts.Mod",
  "src/cli/logs.Mod",
  "src/common/Out.Mod",
  "src/common/In.Mod",
  "src/common/Dates.Mod",
  "src/common/Strings.Mod",
  "src/cli/oberon.Mod",
  "src/cli/stdin.Mod",
  "src/cli/termios.Mod",
  "src/common/POLPO.FATFiles.Mod",
  "src/common/Complete0.Mod",
  "src/cli/shell.Mod",
  "src/cli/boot.Mod",
  "src/cli/cat.Mod",
]
x86 = ["src/cli/x86/system.Mod"]
arm = ["src/cli/arm/system.Mod"]
riscv = ["src/cli/rop2/system.Mod"]
mips = ["src/cli/rop2/system.Mod"]
armv7 = ["src/cli/rop2/system.Mod"]
mipsbe = ["src/cli/rop2/system.Mod"]
ppc = ["src/cli/rop2/system.Mod"]

[FILES]
all = ["Oberon.Text", "texts.md", "VERSION"]
